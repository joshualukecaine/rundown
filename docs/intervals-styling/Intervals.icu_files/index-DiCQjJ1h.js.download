status_dialog_title="{status} Account",account_will_be_made_dormant="Your account will soon be made dormant due to inactivity and new activities will no longer be processed. You can avoid this by visiting Intervals.icu and logging in within the next {0} days.",accurate_device_elevation_help="If you know if the {n} has a barometric altimeter or not then please answer yes or no. Please note that devices with only GPS for elevation are not accurate.",Achievements="Achievements",Actions$1="Actions",Active="Active",activities="activities",Activities="Activities",activities_added_to_compare="Activities have been added to compare list",activities_filtered_out="{n} activities not shown",activity="activity",Activity="Activity",activity_added_to_compare="Activity has been added to the compare list",ACTIVITY_CHART_text="Activity Chart",ACTIVITY_CHART_title="Custom chart for an activity built using Javascript and Plotly",ACTIVITY_FIELD_text="Activity Field",ACTIVITY_FIELD_title="Custom activity field calculated or captured for activities and sport settings",activity_filtered_out="{n} activity not shown",activity_fitness_fatigue_factors="Intervals.icu calculates training load for activities without power using heart rate data. Certain activity types, though they may raise your heart rate, do not increase cardiovascular fitness. The table shows the contribution of each activity type to fitness and fatigue. Types not shown contribute 100% of training load to fitness and fatigue. Activities with zero fitness contribution do not count towards time in HR zones totals. These settings are not used for activities with real power data",ACTIVITY_HEATMAP_text="Activity Heatmap",ACTIVITY_HEATMAP_title="Custom activity heatmap chart",ACTIVITY_HISTOGRAM_text="Activity Histogram",ACTIVITY_HISTOGRAM_title="Custom histogram chart for an activity",ACTIVITY_MAP_text="Activity Map",ACTIVITY_MAP_title="Custom activity map chart",activity_notes_help="Visible to your followers. Not synced to Strava.",ACTIVITY_PANEL_text="Activity Panel",activity_panel_title="Activity fields arranged in nested panels",ACTIVITY_PANEL_title="Custom panel displaying field values for an activity",activity_power_hr_load="This activity has power data so its training load ({power_load}) has been calculated using the standard Coggan formula. If power was not available, the training load from HR data would be {hr_load} (based on the model).",activity_rpe_prompt="Prompt for RPE and feel on recently completed activities when they are opened",ACTIVITY_scope_description="Your rides, runs and other activities",ACTIVITY_STREAM_text="Activity Stream",ACTIVITY_STREAM_title="Custom stream computed for an activity from fit file data or other sources",activity_time_at_hr_blurb="This chart shows the total time accumulated at or above the indicated heartrate. Useful to check that your VO2 max intervals are working!",activity_timeline_chart_help="Press 'A' to add interval or 'S' to split interval at the marker. Click interval header text to edit name etc.. Edit intervals by dragging the edges, this is best done zoomed in. Click on the chart to zoom out.",activity_types$1="Activities that match the selected types will be use the settings defined for this sport. An activity type can only be linked to one sport.",activity_wellness_fields_warning="Warning: Weight and resting HR will still be displayed on activities",Actual="Actual",acwr$1='Acute:Chronic Workload Ratio is your fatigue divided by your fitness. It can be interpreted as follows: 0.80 – 1.30 (optimal workload and lowest relative injury risk; the safe zone) 1.50+ (overloading and highest relative injury risk) - <a href="https://www.sportsinjurybulletin.com/the-acutechronic-workload-ratio-science-or-religion/" target="_blank">The acute:chronic workload ratio – science or religion?</a>',ACWR="ACWR",Add="Add",add_to_compare_blurb="Add to activities for compare",add_to_home_screen1="Did you know that you can install Intervals.icu like an app? Click the share icon at the bottom of the browser:",add_to_home_screen2="Then scroll down and choose 'Add To Home Screen':",add_weather="Click to show wind analysis",add_weather_to_strava_blurb="Add weather information to the description of your Strava activities",add_weather_to_strava_prompt="Would you like to add weather summary information to the descriptions of your Strava activities?",add_wellness_to_calendar="Add wellness fields to calendar",add_wellness_to_form="Add wellness fields to wellness capture form",added_to_coaching_group_msg="You have been added to the group '{0}' which is a coaching group. All current and future admins and coaches in the group will be able to see and update your data. This makes it easier for teams and coaching businesses to manage their athletes. Are you happy with this? Only answer Yes if you trust the group admins.",added_to_group_chat_msg_sub="{0} has added you to '{1}'",added_to_library="{name} has been added to your library",Address="Address",Adjustment="Adjustment",Admin="Admin",Aerobic="Aerobic",aerobic_stream_title="Oxidative energy system contribution",After="After",after_kj="The power duration curve after a significant amount of work has already been done, provides insight into fatigue resistance. See <a href='https://www.outsideonline.com/health/training-performance/fatigue-resistance-research/' target='_blank'>The New Science of Fatigue Resistance</a> and <a href='https://pubmed.ncbi.nlm.nih.gov/33789246/' target='_blank'>paper by Peter Leo et al</a> for more on the topic.",Afternoon="Afternoon",Age="Age",Aggregate="Aggregate",Aggregation="Aggregation",AI_COACH_text="AI Coach",AI_COACH_title="AI advisors, plan and workout generators",All="All",all_rounder_blurb="Good at everything, only the specialists can beat you (Sagan)",allow_login_via_link="Allow {n} to log you in via a link",Altitude="Altitude",altitude_units_help="Altitude is in meters",Amazing="Amazing",Amount="Amount",Analyse="Analyse",analyse_for_pace_zones="Re-analyse this activity to see time in pace zones",ANALYSIS_text="Analysis",ANALYSIS_title="Analysis and presentation of data",Analyze="Analyze",Analyzing="Analyzing",Anchor="Anchor",and$1="and",ANDROID_text="Android App",ANDROID_title="For Android phones and tablets",annual_plan_builder_blurb="Annual training plan builder. Plan for your goal events with generated targets (time, distance, load), workout plan drag and drop and multi-sport support",annual_plan_builder_blurb2="Plan for your goal events with generated targets (time, distance, load), workout plan drag and drop and multi-sport support!",Any="Any",api_key_blurb="Your API key allows other applications to access your Intervals.icu data. Be careful what you do with it! If you suspect that your key may have been compromised immediately clear or re-generate it.",api_key_copied="API key has been copied to the clipboard",api_key_forum_links='Please look at <a href="https://forum.intervals.icu/t/api-access-to-intervals-icu/609" target="_blank">this forum post</a> for more information on how to use the key to call Intervals.icu and available endpoints.',api_key_terms_link='Please note that by using the Intervals.icu API you agree to the <a href="https://forum.intervals.icu/t/intervals-icu-api-terms-and-conditions/114087" target="_blank">Intervals.icu API Terms and Conditions</a>.',App$1="App",app_agreement_note="By connecting with {name} you agree to grant access to your Intervals.icu account to {name}",app_privacy_policy="{name} privacy policy",app_requesting_permissions="{name} is requesting the following permissions:",Apparel="Apparel",apparent_wind_deg="A Wind↗",apparent_wind_deg_help="Wind direction from perspective of athlete",apply_route_blurb="Apply route settings (rename activities, set commute flag etc.) to activities with routes",apply_to_all_existing_activities="Apply to all existing activities?",Apps="Apps",ARCHIVED="Archived",Area="Area",Artifacts="Artifacts",Ascents="Ascents",ask_admin_to_join="If you would like to join this group ask one of the admins",ask_on_forum='If you have have a question about Intervals.icu please <a href="https://forum.intervals.icu" target="_blank">ask on the forum</a>',Athlete="Athlete",athlete_has_not_shared_fitness_charts="{n} has not shared any fitness charts",athlete_has_not_shared_input_fields="{n} has not shared any input fields",athlete_has_not_shared_plans="{n} has not shared any folders or plans with everyone",athlete_has_not_shared_trace_charts="{n} has not shared any activity trace charts",athlete_missing_field="{n} does not have {f}",athlete_plans_blurb="Start date and current week",athlete_setup_custom_items_blurb="Choose custom items to copy to selected athletes",athlete_setup_premium_items="Note that premium features are not applied to athletes who are not supporters",Athletes="Athletes",atl_blurb="This is a 7 day exponentially weighted moving average of your training load",Attacker="Attacker",attacker_blurb="You have excellent 1m power and can put in surge after surge (Valverde)",Authorize="Authorize",Auto="Auto",Availability="Availability",Average="Average",average_watts="Average power is the total work done (measured in Joules) divided by the elapsed time in seconds with stops longer than 30 seconds removed. This is computed from the power data after fixing spikes.",Avg="Avg",avg_hr_load_blurb="Previous activities with power and heart rate are used to build a model that maps average heart rate to training load per hour.",avg_hr_load_dots="Each dot on the chart is from an activity used to build the model",Axel="Axel",Axis="Axis",Back="Back",Bad="Bad",Badminton="Badminton",Balance="Balance",Band="Band",band_blurb="Display a shaded area around moving average plots. The units are standard deviations of the data in the moving average.",Bar="Bar",Bars="Bars",Base="Base",base_phase_weeks="Base Phase (weeks)",Battery="Battery",Bearing="Bearing",best_pace_for_season_0="Best {0} for the season: {1} at {2}!",best_power_for_season_0="Best power for the season: {0}w for {1}!",beta$1="beta",beta_user_blurb="Enable new functionality that may be half finished and even more buggy than usual",Bike="Bike",bio="bio",Board="Board",Boat="Boat",Bottom="Bottom",Brake="Brake",BrakePads="Brake Pads",Branding="Branding",Build="Build",build_phase_weeks="Build Phase (weeks)",bulk_athlete_setup="Bulk Athlete Setup",bulk_athlete_setup_blurb="Easily configure multiple athletes at once, with custom fields, zones and other features",Cable="Cable",Cadence="Cadence",Calculate="Calculate",Calendar="Calendar",calendar_export_blurb="You can view planned workouts, races, holidays and notes in any external calendar that supports subscribing to a Calendar URL (Google, Microsoft, Apple etc.). Click the link below to copy it to the clipboard:",calendar_export_blurb2='Then follow the <a href="https://support.trainerroad.com/hc/en-us/articles/360022469251-Calendar-Export" target="_blank">manual setup instructions from TrainerRoad</a> to add the calendar link to your external calendar. Note that completed activities and planned workouts more than a week old are not included.',CALENDAR_scope_description="Your planned workouts, notes, races etc.",Calendars="Calendars",calories$1="The number of kilocalories burned during the activity. This is supplied by Strava which in turn uses the value supplied by its upload partners.",Calories="Calories",can_only_del_empty="You can only delete an empty {type}",Cancel="Cancel",Canoeing="Canoeing",cant_find_friends_blurb="Can't find your friends and athletes? Send them <a>a link to join</a> Intervals.icu",capture_notes_on_activity="Capture notes about this activity and discuss it with your followers.",capture_your_ftp="Capture your FTP to enable power zones and analysis for activities with power in this sport",capture_your_threshold_hr="Capture your threshold HR and max HR to enable heart rate zones and analysis for activities with HR in this sport. Even if you have a power meter the relationship between power and heart rate is worth monitoring",capture_your_threshold_pace="Capture your threshold pace to enable pace zones and analysis for for this sport",Carbohydrates="Carbohydrates",Carbs="Carbs",Carbs_g="Carbs(g)",carbs_ingested$1="CHO Ingested",carbs_ingested_title="Carbohydrates ingested in grams",carbs_per_hour_help="How many grams of carbohydrates should the athlete ingest per hour",carbs_per_hour_title="Carbohydrates per hour",carbs_used$1="CHO Used",carbs_used_blurb=`Carbohydrate utilisation is calculated using the TSS model from
<a href="https://link.springer.com/article/10.1007/s40279-024-02131-z" target="_blank">this paper by Rothschild et al</a>. For more information look at <a href="https://forum.intervals.icu/t/carb-utilisation-and-ingestion-on-activities/78676" target="_blank">this forum post</a>.`,carbs_used_title="Carbohydrate utilisation in grams",Card="Card",Cassette="Cassette",Categories="Categories",Category="Category",Celsius="Celsius",Center="Center",Chain="Chain",Chainrings="Chainrings",Chart="Chart",chart_extras_blurb="Click 'Add Item' to customize the chart background with shaded zones, lines etc.",chart_garmin_data_attribution="Charts may include data from Garmin devices",chart_script_blurb="JavaScript code to build the chart",Charts="Charts",Chat="Chat",chat_added_member="Added '{0}'",chat_changed_group_description="Changed group description to '{0}'",chat_changed_group_icon="Changed group icon",chat_changed_group_name="Changed group name to '{0}'",chat_changed_group_url="Changed group URL to '{0}'",chat_coaching_group_off="This group is now a normal (non-coaching) group",chat_coaching_group_on="This group is now a coaching group",chat_coaching_via_group="I am now {0} you because I am {1} in {2}",chat_group_hidden="Made group hidden from non-members",chat_group_visible="Made group visible to non-members (excluding chat messages, workouts and training plans)",chat_left_the_group="Left the group",chat_member_new_role="'{0}' is now a group {1}",chat_removed_athlete="Removed '{0}' from the group",Chats="Chats",CHATS_scope_description="Your chats, groups and messages",check_garmin_settings="Plese check your Garmin settings for Intervals.icu:",check_inbox_for_email="Please check your inbox and spam for a confirmation email and click the link",Checkout="Checkout",CHO="CHO",chronic_intensity_load="Chronic intensity load (CIL) is a 42 day exponentially weighted moving average of the intensity for each activity. It is similar to fitness but removes the weighting for duration. It is a useful measure to look at when you are trying to reduce volume and maintain or increase intensity - <a href='https://www.trainingpeaks.com/blog/chronic-intensity-load-a-new-measure-of-training-load-based-on-intensity-factor/' target='_blank'>Chronic Intensity Load</a>",CIL="CIL",circle_all_radius_help="Define a radius to hide the start and end of all activities from maps",City="City",Class="Class",Classification="Classification",Clear="Clear",Cleats="Cleats",click_for_info="Click for more info",click_link_to_confirm_email="Click the link below or cut and paste it into your browser to confirm your email address:",click_the_share_button="Click the share button to share with others.",click_title_to_select_totals="Click the title to select a totals table",click_to_reactivate="Click for more info or to reactivate your account",click_to_reset_password="Click the link below or cut and paste it into your browser to reset your password:",Climber="Climber",climber_blurb="Long steep climbs are your thing, let the big guys deal with the wind (Froome)",Climbing="Climbing",Close="Close",Clouds="Clouds",Coach="Coach",coach_me_req_msg_content="{0} would like you to coach them. You will be able to see and update their activities, training plan and other settings.",coach_me_req_msg_sub="{0} would like you to coach them",coach_req_msg_content="{0} would like to coach you. They will be able to see and edit your activities, calendar and other settings.",coach_req_msg_sub="{0} requested to coach you",coach_request_sent="Coach request sent!",coach_tick_blurb="How well did the athlete perform?",coached_athletes_from="Athletes you coach from {n}",coached_athletes_tagged="Coached athletes tagged {n}",Coaching="Coaching",coaching_group_warning="This is a coaching group. If you join it, all the current and future admins and coaches in the group will be able to see and update your data. Only join the group if you trust the admins.",coaching_groups="Coaching Groups",coaching_groups_blurb="For teams and coaching organisations. Create groups of athletes to automatically assign coaches, configure settings and other features.",Coasting="Coasting",coasting_time$1="This is time spent moving at 1 km/h or more while producing 10w or less of power.",Code$2="Code",coggan_power_profile="This chart shows your watts/kg for some standard durations and estimated FTP plotted against values for different levels of riders from Dr Andy Coggan.",Coins="Coins",coins_blurb="Purchase coins to make members of this group supporters and give them access to premium features! One coin pays for one month of supporter.",Color$1="Color",color_range_blurb="Adjust the cell background colour using a linear range, leave min and/or max empty to auto select based on the data",Colors="Colors",Cols="Cols",Column="Column",Columns="Columns",combined_zones_blurb='The combined zones uses one of the power, heart rate or pace "time in zones" respectively for each activity to calculate the totals for the time period',Comfortable="Comfortable",Comment="Comment",comment_on_activity="Comment on this activity to help {name} with their training.",commented_on_activity_msg_sub="{0} commented on {1}",commented_on_other_activity_msg_sub="{0} commented on {1}'s {2}",Comments="Comments",Commute="Commute",commute_not_shown="1 commute is not displayed",Commutes="Commutes",commutes_hidden="{n} commute(s) hidden",commutes_not_shown="{n} commutes are not displayed",Compact="Compact",Compare="Compare",complete_config_for_preview="Complete the configuration to see preview",Compliance="Compliance",compliance_blurb="Compliance is calculated for activities in weeks that have at least one planned workout for the sport. If the activity has not been paired with a planned workout then compliance is 0%. Otherwise the activity training load is compared to the planned training load. If load is not available then the activity moving (or elapsed) time is compared to planned workout duration. If you do not want to calculate compliance for an unpaired activity (e.g. a warmup logged separately) then tick the ignore compliance box.",Component$1="Component",Components="Components",compound_score_5m=`The compound score is absolute power (w) x relative power (w/kg) for a given duration (here 5 minutes). It has been found to be more predictive than 5m absolute or relative power alone of pro-continental U23 one day racing success - <a href='https://www.researchgate.net/publication/361643363_The_Compound_Score_in_elite_road_cycling' target='_blank'>The Compound Score in elite road cycling</a>
`,Computer="Computer",configure_activity_fields="Edit activity summary",configure_activity_fields_blurb="Change the layout and fields displayed on the activity summary and add your own panels to the activity detail tabs",configure_pace_zones="Configure pace zones for this sport in settings to see time in pace zones",confirm_cancel_subscription="Are you sure you want to cancel your subscription?",confirm_change_code="Are you sure you want to change code from {old} to {new}? This will hide any data already saved as {old}",confirm_clear_intervals="Are you sure you want to remove all the intervals?",confirm_clear_plan="Are you sure you want to clear the training plan? All future planned workouts will be deleted! If you want to keep any workouts copy them to your library first. Note that races, workouts from external calendars and other entries are not deleted.",confirm_clear_week="Are you sure you want to delete all workouts in this week?",confirm_crop_activity="Are you sure you want to crop this activity to the portion currently selected?",confirm_del="Are you sure you want to delete {name}?",confirm_del_activity="Are you sure you want to delete this activity?",confirm_del_athlete="Are you sure you want to delete {name}? You will no longer be able to see their Intervals.icu data.",confirm_del_ext_cal_entry="It is from {name} and might come back next time you refresh that calendar.",confirm_del_folder="Are you sure you want to delete this {type}?",confirm_del_plan_warning="This will remove the plan and all associated workouts from your calendar. This action cannot be undone.",confirm_del_workout="Are you sure you want to delete this workout?",confirm_delete_account="Are you sure you want to delete your account? All of your data will be deleted. This action cannot be undone! Enter 'yes' in the box below and click 'OK' to delete your account.",confirm_delete_activities="Are you sure you want to delete {n}? If you make a mistake you can undelete activities but this takes a long time and won't restore any edits. So be careful!",confirm_delete_gear="Are you sure you want to delete {n}? This action cannot be undone.",confirm_delete_intervals="Are you sure you want to delete {n} interval(s)?",confirm_delete_plot="Are you sure you want to delete this chart plot?",confirm_delete_privacy_circle="Are you sure you want to delete this privacy circle?",confirm_delete_reminder="Are you sure you want to delete this reminder?",confirm_delete_sport_settings="Are you sure you want to delete settings for {type} ?",confirm_delete_week="Are you sure you want to delete this week and all its workouts?",confirm_demote_self="Are you sure you no longer want to be an admin for this group?",confirm_disconnect_from="Are you sure you want to disconnect from {n}?",confirm_email_plan="Are you sure you want to email the plan for the week of {week} to {name}?",confirm_extract_workout="Do you want to try and extract a workout from this activity file? Some activity files contain workout steps e.g. when using a Garmin device to perform a workout on an indoor trainer.",confirm_fix_data="Are you sure you want to adjust data for {n}",confirm_generate_link="Are you sure you want to generate a new invite link? Your current link will no longer work.",confirm_goto_settings_update_ftp="Your eFTP has increased to {estFtp}w. You should consider updating your {type} FTP in settings so that your power zones adjust and training load is calculated correctly.",confirm_goto_settings_update_lthr="Your threshold heart rate appears to have increased to {value} bpm. You should consider updating your {type} threshold HR and HR zones in settings. Don't change anything if you were dehydrated or if you know your HR was elevated for some other reason.",confirm_kick="Are you sure you want to kick {name} from the group?",confirm_leave_group="Are you sure you want to leave '{name}'?",confirm_make_admin="Are you sure you want to make {name} an admin?",confirm_make_coaching_group="Are you sure you want to make this group a coaching group? Admins and coaches in the group will automatically coach (can see and update data and settings) all normal members in the group. Athletes already in the group will need to log in and accept this or leave the group.",confirm_make_not_coaching_group="Are you sure you want to make this group a normal group instead of a coaching group? Current group member coaching relationships will not be changed but new members will no longer be automatically coached.",confirm_reanalyze_activities="Are you sure you want to re-analyze {n}? Any manual interval edits will be undone.",confirm_remove_plan="Are you sure you want to take {name} off this training plan?",confirm_replace_gear="Are you sure you want to replace {n}? It will be retired and a copy with no distance and time assigned to the same gear items, with the same reminders.",confirm_reprocess_activities="Are you sure you want to reprocess the files for {n}? All edits will be undone.",confirm_reset_reminder="Are you sure you want to reset this reminder?",confirm_restore_default_colors="Are you sure you want to restore the default colors?",confirm_retire_component="Are you sure you want to retire {n}? It will no longer be displayed by default and will be removed from any gear it has been assigned to.",confirm_retire_gear="Are you sure you want to retire {n}? It will no longer be displayed by default.",confirm_share_folder_with_all="Are you sure you want to share this folder with all the athletes you coach?",confirm_share_folder_with_tag="Are you sure you want to share this folder with athletes you coach with the tag {tag}",confirm_stop_import_from_file="Are you sure you want to stop importing from this file?",confirm_strava_disconnect=`Are you sure you want to revoke Intervals.icu access to your Strava data? <span class="red--text">The Strava API terms of service requires that all data on Intervals.icu that originated from Strava be deleted.</span> Enter 'yes' in the box below and click 'OK' to revoke access and delete your Strava data from Intervals.icu.`,confirm_undelete_activities="Are you sure you want to undelete {n}?",confirm_unlink_folder="Are you sure you want to unlink this folder from Intervals.icu?",confirm_update_zones_activities="Are you sure you want to update zones on {n}? Any existing FTP, W' and threshold pace values are kept, only the zones are updated. If the sport has HR zones then threshold HR and max HR are updated.",Connect="Connect",connect_strava="Connect your Strava account to analyse your activities on Intervals.icu.",connect_strava_warning="Note that if you revoke Intervals.icu access or Strava requires us to do so, then Intervals.icu will delete all data originating from Strava.",connect_with_app="Connect with {name}?",Connected="Connected",connecting_to="Connecting to {name} ...",Connections="Connections",Console="Console",Contours="Contours",Convert="Convert",convert_distance="Fields that are in meters can be converted to other distance units (e.g. km or miles).",convert_time="Fields that are in seconds can be converted into durations in various formats.",convert_workout_files="Convert {types} workout files",Cookies="Cookies",Cooldown="Cooldown",cooldown_time="Intervals.icu excludes the last few minutes of an activity (cooldown) when calculating decoupling. This is the default cooldown time for new activities.",Copy="Copy",Coros="Coros",COROS_text="Coros",COROS_title="Coros watches and other devices",Count="Count",Country="Country",course_upload_hint="Upload FIT, GPX or TCX files to add courses to the event with maps, elevation profile and weather forecasts!",Crankset="Crankset",Create="Create",create_groups_blurb="Create and join groups to share workouts and training plans, post interesting content and chat with other athletes!",Crop="Crop",Crossfit="Crossfit",cs_blurb="CS (critical speed) and D' are calculated using the 2 parameter model. Intervals.icu uses your best 1k, 2k, 3k, 4k and 5k times keeping those that take between 2 and 15+ minutes.",CSV="CSV",ctl_blurb="This is a 42 day exponentially weighted moving average of your training load",Custom="Custom",custom_field_aggregate_blurb="How values for multiple activities on the same day should be combined on fitness charts",custom_item_copied="{n} has been copied",custom_streams_blurb="Intervals.icu can create custom activity data streams from records in fit files. These can be plotted on their own as well as added to custom activity charts. Activities need to be re-processed to extract data for new streams.",custom_zones_blurb="Create zones for any activity stream (not just power, HR and pace) with any values as anchors, for workout prescription and time in zones",Cut="Cut",cycling_model_warning="Please note that all the power models have been derived from Cycling power data and they may not be applicable to power data from other sports.",Cyclocross="Cyclocross",Data="Data",data_capture_vis_blurb="Data you capture for the field is only visible to your followers.",date_of_birth="Your date of birth is used to calculate age related rankings and other related analysis.",Day="Day",days="days",Days="Days",decoupling$1="decoupling",Decoupling="Decoupling",decoupling_blurb="As you get fitter you produce more power at a given HR. Your aerobic fitness reduces cardiac drift but this is also influenced by temperature, hydration level and time of day.",decoupling_help="Aerobic decoupling % compares your power / HR ratio for the first half of your ride to the second. Usually your power for a given HR will be higher for the 1st half of a ride than the 2nd and the percentage positive. Base training will improve (reduce) your aerobic decoupling. Be aware that there are many confounding factors that influence heart rate and this measure is applicable to endurance rides. See <a href='https://tailwind-coaching.com/2017/03/30/what-is-aerobic-decoupling/' target='_blank'>tailwind-coaching.com</a>.",Default="Default",default_gear="New activities for this sport will be assigned this gear",default_indoor_gear="New indoor activities for this sport will be assigned this gear",default_percent="Default: {percent}%",default_power_target="Individual workout steps using power can specify how the power target is interpreted (lap power, instant power, 3 second power etc.). This setting defines the default value.",default_workout_time="Workout Start Time",default_workout_time_blurb="Workouts created without a start time (or at midnight) for this sport are given this start time",Defaults="Defaults",Del$1="Del",del_from_ext_cal_note="It is from '{name}' and might come back next time you refresh that calendar.",del_target_others_note="You can also delete other targets that were added at the same time by selecting 'Yes & Others'.",del_workout_others_note="You can also delete other workouts that were added at the same time by selecting 'Yes & Others'.",Delete="Delete",delete_account_info="If you no longer wish to use Intervals.icu, you can delete your account at the bottom of the settings page",Deleted$1="Deleted",Deleted_n="Deleted {n}",Deleting="Deleting",Derailleur="Derailleur",Descending="Descending",Descents="Descents",Description="Description",Details="Details",dev_lang_blurb="Translations for these languages may be incomplete or machine generated and text might overflow in places",dev_lang_help_blurb="If you would like to see Intervals.icu in your own language or can help improve translations please <a href='https://forum.intervals.icu/t/localisation-of-intervals-icu/4634' target='_blank'>visit the forums</a>",Device="Device",Diastolic="Diastolic",did_not_match_upload_filter="Workout did not match upload filter, check your settings",Difficult="Difficult",Disabled="Disabled",Disconnect="Disconnect",disconnected_from="Disconnected from",disconnected_from_activities_blurb='Intervals.icu has been disconnected from {0}. If you would like to continue downloading activities from {0} please reconnect in <a href="https://intervals.icu/settings">settings</a>.',disconnected_from_message="Intervals.icu has been disconnected from {0}, please reconnect in {1} ",disconnected_from_training_blurb='Intervals.icu has been disconnected from {0}. If you would like to continue uploading planned workouts to {0} please reconnect in <a href="https://intervals.icu/settings">settings</a>.',disconnected_from_wellness_blurb='Intervals.icu has been disconnected from {0}. If you would like to continue downloading wellness data from {0} please reconnect in <a href="https://intervals.icu/settings">settings</a>.',Display="Display",display_settings_help="These settings can also be edited on the calendar page (Options -> Edit Layout)",displayed_welless_fields="Wellness fields displayed on calendar",Dist="Dist",distance$3="You might want to edit this for an indoor trainer ride if the distance hasn't been calculated correctly.",Distance="Distance",do_not_delete_workouts_before="Do not delete workouts before {d}",do_not_send_me_mails_like_this="Do not send me mails like this",donate_blurb="Your subscription will help cover hosting costs and fund ongoing development of the platform. You can cancel at any time.",donate_please_support="If you are enjoying Intervals.icu please consider supporting the project with a $4/month subscription. The monthly hosting costs are substantial as is the time required to keep everything running. Supporter feature requests move up the todo list!",DORMANT="Dormant",Dots="Dots",Download="Download",download_busy="Download already in progress, please be patient",download_in_progress="Download in progress, please be patient",download_new_activities_from_strava="Download new activities from Strava",download_old="Download old {label}",download_old_data_blurb="{label} between the dates will be downloaded. They may take a several minutes to appear on your calendar.",download_old_garmin_warning='Garmin does not allow data older than one year to be downloaded and only allows a single call to the API. Please get your dates right first time! If you need more use the "Import All Garmin Data" button. This takes a while but you get everything.',download_wellness_from_whoop="Download wellness data from WHOOP",Downloading="Downloading",downloading_activities="Downloading {0} activities",Drivetrain="Drivetrain",Dropbox="Dropbox",dropbox_add_folders_to_download="Add folders to download FIT, TCX and GPX files or upload activities to Dropbox",dropbox_upload_folder_blurb="All activities uploaded to Intervals.icu go here (except Strava) and files are deleted when activities are deleted",Duplicate="Duplicate",duplicate_chart_blurb="Create a copy of this chart",duplicate_shared_event_blurb="Similar events already exist on the same date in this country",duplicate_shared_event_confirm_create="Do you still want to create this event?",Duration="Duration",duration_and_example="Duration e.g. 3m",duration_label="Duration e.g. 3m",E$1="E",Easy="Easy",eCP="eCP",ecp_blurb=`Estimated CP is calculated using power curves from FastFitness.Tips and Morton's 3 parameter critical power model. The algorithm requires just 1 max effort of between 180 seconds and 30 minutes. This is the same algorithm as eFTP but W' is relative to CP and CP is presented instead of the model power at 1h (FTP).
`,Edit="Edit",edit_axis_blurb="Edit axis labels, min, max and chart title",edit_best_efforts_pace_blurb="What distances are you interested in tracking?",edit_intervals_blurb="Note that you can edit individual intervals by clicking on the header showing the interval stats",edit_summary_blurb="Change activity summary fields and layout",edit_tab_blurb="Rename, move or delete active tab",edit_training_log_layout_help="Click the cog icons displayed on the configurable parts of the calendar to change the fields displayed and other options. Click the {n} button again to stop editing.",Editing="Editing",editing_n_intervals="Editing {n} selected intervals visible on the chart",Editor="Editor",Efficiency="Efficiency",efficiency_factor="Efficiency Factor is normalized watts (output) divided by average heart rate (input). The question that the Efficiency Factor is answering is how aerobically fit, are you? The Efficiency Factor should be used for tracking your aerobic level - <a href='https://cyklopedia.cc/cycling-tips/efficiency-factor/' target='_blank'>cyklopedia.cc</a>",eFTP="eFTP",eftp_blurb="Estimated FTP is calculated using power curves from FastFitness.Tips and Morton's 3 parameter critical power model. The algorithm requires just 1 max effort of between 180 seconds and 30 minutes. Note that all data for the selected power curves is used and there is no decay so the eFTP value on the chart may differ to your current eFTP. W' is relative to eFTP.",eftp_help_part1="Estimated FTP for this activity on its own is {ftp} W (from {secs} at {watts} W).",eftp_help_part2="This is less than the model value of {watts} W so the model value has been kept.",eftp_highest_in_season="The value shown here is the highest achieved during each season.",Elapsed="Elapsed",Elevation="Elevation",elevation_correction="Elevation data from GPS devices tends to be very inaccurate. Elevation data from Strava and devices with barometric altimeters is usually accurate. In 'Auto' mode inaccurate elevation data is corrected by looking up GPS points on a database of <a href='https://www.opentopodata.org' target='_blank'>topographic maps</a>. The elevation data is used to calculate gradients for gradient adjusted pace.",Elliptical="Elliptical",Email="Email",email_blurb='You are receiving this mail because you have signed up with <a href="https://intervals.icu/">Intervals.icu</a>.',End="End",end_when_lap_button_pressed="End when lap button pressed (Garmin/Suunto only)",endurance="endurance",ENE="ENE",enter_cal_url="Enter a URL or link to a calendar in iCalendar (.ics) format",enter_dob="Please enter your date of birth and height to view power profiles",enter_points_on_curve="Enter at least 2 points on the curve",Entered="Entered",ePmax_blurb="Estimated Pmax is an estimate of your best 1s power. If you exceed this value on an activity then it will go up. It decays slowly (like eFTP) if you reduce training load. You need to do a flat out sprint every now and then to keep the model up to date.",ePmax_title="Estimated Pmax",EPOC="EPOC",Equipment="Equipment",ESE="ESE",Evening="Evening",Events="Events",events_are_workouts="Events are planned workouts",eWPrime_blurb="Estimated W prime (W') is updated whenever your eFTP goes up. It estimates the amount of energy in Joules available when riding above threshold (FTP) before you have to drop below threshold to recover. If you reduce training load, eW' decays slowly (like eFTP). Every now and then you need to do a long enough max effort to set a new eFTP and eW prime, to keep the model up to date.",eWPrime_title="Estimated W Prime",Example="Example",expected_n="Expected {n}",Expression="Expression",Extreme="Extreme",Factor="Factor",Failed="Failed",Farenheit="Farenheit",Fat="Fat",Fat_g="Fat(g)",fatigue$1="Fatigue is a 7 day exponentially weighted moving average of your training load.",Fatigue="Fatigue",fatigued_curve_ranking_note="Please note that the rankings for fatigued power curves ({list}) are relative to fresh athletes and not others with a similar level of fatigue",Fatness="Fatness",feature_not_on_mobile="Unfortunately the {link} is not supported on mobile screen sizes. Please use a tablet or laptop.",Features="Features",features_only_for_subscribers="Features only available to subscribers:",feel$3="How did you feel?",Feel$1="Feel",Female="Female",Field="Field",field_pace_units="Fields that are in meters/second can be formatted as pace instead of using the number format or speed (still uses number format).",Fields="Fields",File="File",Filter="Filter",Filters$1="Filters",find_intervals_help="Find efforts by power, pace etc. and create intervals",fit_record_field="Most per time tick data in fit files is stored in record messages composed of fields (watts, heart rate, altitude etc.). This is the name of the field to use for this stream.",fit_session_field='FIT files for activities include records with summary information for the activity. Enter the name or field number of a session record field here to fill the activity field with its value when FIT files are read and written. You can read other record types by prefixing the name or number of the field with the name or number of the record and a dot (e.g. "140.4") You can examine FIT files at fitfileviewer.com. If this value is not set, is numeric or contains a dot then the field code is used for its name when a FIT file is written.',fitness$1="Fitness is a 42 day exponentially weighted moving average of your training load.",Fitness="Fitness",FITNESS_CHART_text="Fitness Chart",FITNESS_CHART_title="Custom chart on the /fitness page",fitness_formula_help="Math expression using field names as variables e.g. fitness - fatigue",fitness_plots_blurb="You have not created any custom fitness charts yet. You can do that on the fitness page and then use this toolbar to show the numbers on the calendar.",fitness_table_no_columns="No columns configured, click the pencil icon to add columns",fix_altitude_note="Activities that do not have elevation correction enabled will be ignored",fix_altitude_title="Rebuild elevation corrected altitude data",fix_data_blurb="Apply function to fix power, HR and altitude data",Folder="Folder",folder_build_lib_help="Drag and drop workouts from the calendar or click ⋮ to build your library",folder_confirm_del="Are you sure you want to {op} {name}?",folder_drag_help="Drag workouts from your library or click on the calendar to add workouts",folder_not_shared_with_athletes="This folder is not shared with any athletes",folder_workouts_del_warning="The workouts in the folder will also be deleted",Follow="Follow",follow_req_msg_content="{0} would like to follow you. They will be able to see your activities and power and learn from your vast experience.",follow_req_msg_sub="{0} requested to follow you",Follower="Follower",Followers="Followers",Following="Following",follows_you="They follow you",For="For",Forecast="Forecast",Fork="Fork",form$1="Form is your fitness less fatigue. To get fitter you need to create stress by increasing training load (fatigue higher than fitness) resulting in negative form. Reduce training ahead of important races (positive form) and in periodic rest weeks to recover - <a target='_blank' href='https://www.sciencetosport.com/monitoring-training-load/'> Science2Sport</a> and <a target='_blank' href='https://www.joefrielsblog.com/2015/12/managing-training-using-tsb.html'>Joe Friel</a>.",Form="Form",form_as_percent="Form is your fitness less fatigue. This can be displayed as an absolute number (e.g. -10) or as a percentage of your current fitness (e.g. -20%). The percentage option scales the zones (e.g. optimal training) to match your current fitness. However if your fitness is low (less than 60) it will exaggerate your form and might push you into the high risk zone. So only use the percentage if you do a lot of training.",form_blurb='To get fitter you need to create stress by increasing training load i.e. keeping the purple line above the blue line. Your form is your fitness less fatigue. When your form is in the <b class="optimal">optimal training zone</b> you are gaining fitness. When your form is <b class="fresh">fresh</b> and you are fit then you are ready to race. Avoid staying in the <b class="highRisk">high risk zone</b> for long or you might become over-trained. You need to include periodic rest weeks in your training to recover from fatigue and to be at your best for goal events.',Format="Format",Formula="Formula",Forum="Forum",Frame="Frame",Free="Free",free_strava_download_limit="Historical data download from Strava by Intervals.icu free users is limited to {months} months due to Strava API rate limits. Intervals.icu supporters can download all of their Strava data.",Freeride="Freeride",Fresh="Fresh",Fri="Fri",Friday="Friday",From="From",from_app="From {n}",ftp$1="FTP stands for Functional Threshold Power, which is commonly defined as the highest average power you can sustain for an hour, measured in watts. FTP is often used to determine training zones when using a power meter and to track improvement - <a href='https://www.bikeradar.com/road/gear/article/ftp-for-cycling-what-functional-threshold-power-means-how-to-test-it-and-how-to-improve-it-48624/' target='_blank' tabindex='-1'>bikeradar.com</a>",FTP="FTP",ftp_est_min_secs="Estimated FTP is calculated by placing you on a power curve using a single maximal effort of between 180 seconds and 30 minutes. If your anaerobic (short duration) power is very good you might want to use longer durations to avoid over-estimating your FTP.",ftp_up_0="Your estimated FTP has increased by {0}w to {1}w!",ftp_up_from_ui="FTP +{delta} to {value}w from {time} at {watts}w ",ftp_up_ui="FTP +{delta} to {{value}}w",Full="Full",full_strava_history="Download full Strava history from the API (limited to 3 months for free users)",future_days="Workouts up to this many days in the future will be uploaded",Gain="Gain",gap$2="Gradient Adjusted Pace uses the gradient of the terrain to calculate an equivalent pace on the flat. The adjusted pace will be faster on uphills and slower on downhills. Intervals.icu uses the running GAP model from <a href='https://medium.com/strava-engineering/an-improved-gap-model-8b07ae8886c3' target='_blank'>Strava</a>. GAP is used to estimate training load from pace.",GAP="GAP",garmin_connect_replace_strava="Activities downloaded from Garmin Connect will replace those from Strava",garmin_download_activities_blurb="Activities created on or after this date are downloaded from Garmin Connect. This might take a while. The data cannot be more than one year in the past due to Garmin API restrictions. Please note that activities from non-Garmin devices (e.g. TrainerRoad) are not supplied to Intervals.icu. Use Dropbox for these.",garmin_import_complete="Garmin data import complete",garmin_sync_activity_types_blurb="Only download specific activity types from Garmin. Please be careful. Garmin does not allow duplicate calls to fetch old data so you cannot recover from incorrectly excluding activity types using the download old data button. If this happens you will need to manually download the FIT files from Garmin Connect and upload them on the calendar page.",GARMIN_text="Garmin",GARMIN_title="Garmin watches, cycle computers and other devices",garmin_upload_filters_blurb="Add filters to select which planned workouts will be uploaded to Garmin Connect. Workouts for the next week are uploaded.",Gauge="Gauge",gauge_blurb="Moving average only counts days with a measurement",gauge_blurb_help="Moving average plots on the fitness page count days without a measurement as zero if this box is not ticked. If you change this setting you need to re-add existing plots on custom charts to update them.",Gear="Gear",gear_activity_filters_blurb="New activities are assigned gear by comparing the activities against filters configured on each gear item (most recently created gear first). You can filter by activity type (Ride, MTB, Gravel Ride etc..), name, power meter and other fields available at activity creation time. If no gear matches then the default gear settings for the sport are used.",gear_reminder_reset="Remember to reset reminders if you want to receive more of these emails in future!",GEAR_text="Gear",GEAR_title="Bike, shoes and other gear trackers",gender_not_set="Your gender is not set, please update your settings.",Generate="Generate",generating_preview="Generating preview...",Glucose="Glucose",Glycolytic="Glycolytic",glycolytic_stream_title="Lactic energy system contribution",Golf="Golf",Good="Good",googlefit_confirm_disconnect="Are you sure you want to disconnect from Google Fit?",googlefit_timezone_blurb="Please note that Google Fit does not return timezone information. Intervals.icu assumes that dates and times are in your Intervals.icu timezone of {tz}. If this timezone is incorrect press cancel and change it (top of this page) before connecting.",Gradient="Gradient",grant_dropbox_write_access="You need to grant Intervals.icu write access to your Dropbox before you can add an upload folder. Click OK to do this. On return to Intervals.icu you will be able to add an upload folder.",Great="Great",Grey="Grey",group_admins_blurb="Group admins can change group settings and add and remove athletes",group_drag_and_drop="Drag and drop folders, plans and individual workouts to your library",group_link_share_blurb="Copy this link and share it with people who need to join the group, they will still need to ask one of the admins to join",group_no_plans_shared="No folders and training plans have been shared with this group",group_role_admin_help="Can change group settings and add and remove athletes",group_role_coach_help="Has coach access to all group members (coaching groups only)",group_role_follower_help="Can see but not update activities and other data for for all group members (coaching groups only)",group_role_not_coaching_group="This group is not a coaching group. Coach and Follower roles only have effect in coaching groups.",group_ui_blurb="Customize Intervals.icu for users who have this group set as their primary group",Groups="Groups",Grumpy="Grumpy",Gusts="Gusts",Handcycle="Handcycle",Handlebar="Handlebar",Hard="Hard",HARMONY_OS_text="HarmonyOS",HARMONY_OS_title="Huawei watches (e.g GT series)",he$1="he",Headset="Headset",Headwind="Headwind",heartrate$1="heartrate",Heartrate="Heartrate",Heartrate_short="Heartrate",Heatmap="Heatmap",heatmap_chart_title="Plot one activity trace against another",Height="Height",height_feet_help="Height (e.g 5'11)",Height_of_person="Height",Hello="Hello",Help="Help",her="her",hidden="hidden",Hidden="Hidden",hidden_from_athlete="Workout is hidden from the athlete",hidden_strava_activity="Hidden Strava activity",hidden_strava_activity_blurb="The Strava API terms of service prohibit Intervals.icu from showing activities obtained via the API to Intervals.icu followers. Only coaches can see them.",hidden_strava_activity_list_blurb="There are {n} activities from Strava that are not shown in the the list",hidden_strava_activity_list_blurb_singular="There is 1 activity from Strava that is not shown in the the list",Hide="Hide",hide_script_blurb="Prevent other athletes from being able to see or edit the script. This only applies to items that have been shared with others.",High="High",HIIT="HIIT",Hike="Hike",him="him",his="his",Histogram="Histogram",histogram_bucket_trim_blurb="Remove head and tail buckets with less than this % of the total",histogram_chart_title="Plot any activity trace in buckets",History="History",Hockey="Hockey",Holiday="Holiday",Hour="Hour",hourly_data_limit="Hourly data is only available for the next 120 hours",Hours="Hours",HR="HR",HR1="HR1",HR2="HR2",HR3="HR3",HR4="HR4",HR5="HR5",HR6="HR6",HR7="HR7",hr_load_model_not_enough_data="You do not have enough activities with power and heart rate so a general (not athlete specific) model has been used.",hr_load_model_r2_blurb="Each dot on the chart is from an activity used to build the model. The y-axis shows the difference between the estimated and actual training load for each activity as a percentage of the actual load.",hr_load_plot_r2_blurb="Each dot on the chart is from an activity with power and HR used to evaluate the model. The y-axis shows the difference between the estimated and actual training load for each activity as a percentage of the actual load.",hr_load_type="Intervals.icu can estimate training load for activities without power data by using previous activities with power and heart rate data. Either the time in each HR zone or the average HR for each activity is used. This works well for cycling but does not generalize well to other sports. For running and other sports HRSS (from <a href='https://github.com/thomaschampagne/elevate/issues/341#issuecomment-322047898' target='_blank'>Elevate</a>) works better. This is <a href='http://www.trainingimpulse.com/banisters-trimp-0' target='_blank'>TRIMP</a> normalized to more closely match power based training load. You need to capture your resting HR for HRSS.",hr_range="Workout steps with exact heart rate targets are converted into ranges of plus/minus this percentage of the target heart rate",hr_spikes="Heartrate spikes are detected and fixed by comparing the HR trace to your max HR. Spikes above max HR are replaced with a line interpolated between the HR values before and after the spike. If the HR data for an activity is very poor you can ignore the HR trace by clicking the cog icon. You can see the unmodified HR trace by clicking the charts button and adding Raw HR.",hrLag="The delay in seconds between an increase in power and a corresponding increase in heart rate. Your heart rate doesn't respond immediately when you put the power down and takes a while to recover when you ease off.",hrrc$1="HRRc measures how quickly you recover after a hard effort. It is the largest drop in HR over 60 seconds starting from a HR of at least threshold. The general idea is that, the faster or greater your drop in heart rate, the better your recovery - <a href='https://www.pezcyclingnews.com/latestnews/toolbox-heart-rate-recovery/'>www.pezcyclingnews.com</a>",HRRc="HRRc",hrrc_min="This setting controls the minimum HR required to trigger the calculation",hrrc_min_in_settings="The minimum HR required to trigger the calculation can be configured for each sport in /settings",hrss_load_blurb="The model uses time spent at each HR value relative to threshold and your HR reserve (max - resting HR) to estimate training load.",hrv_hr$1='This is HRV normalized by resting HR. Please note that resting HR and rMSSD must come from the same source for this metric to have any validity! "It can provide useful insights. For example, on days when heart rate drops and HRV is stable, normalized HRV reflects that despite more room for variability, your HRV has not increased, and is in fact lower than your normal." ~  <a href="https://forum.intervals.icu/t/normalised-hrv-added-to-fitness-page/106679" target="_blank">Marco Altini</a>',HSI="HSI",huawei_ad_footer="Track your progress and make informed training decisions!",huawei_ad_line1="Sync your runs, rides and other activities to Intervals.icu",huawei_ad_line2="View your heart rate, weight, and other Huawei wellness data in Intervals.icu",huawei_ad_line3="Upload your planned runs from Intervals.icu to your Huawei watch",huawei_ad_title="Train smarter with Huawei and Intervals.icu!",huawei_historical_data_scope_needed="You need to grant Intervals.icu access to your historical data. Please tick the 'Read data from the year prior to authorisation in Health Service Kit' box on the Huawei consent page",huawei_missing_scopes_warning="You need to grant Intervals.icu access to your HUAWEI Health data for {n}",huawei_no_data_received_warning="Data was last received from HUAWEI Health {ago}, please check that Health Service Kit is linked in the Huawei app",huawei_privacy_policy=`When you connect your HUAWEI Health account to Intervals.icu, we access and process your fitness data to provide you
with comprehensive training analytics and coaching tools. The data collected and stored through this service is
intended for reference only and must not be used as a basis for medical diagnosis.

## Activity Data

We can download your completed activities (exercise records) including location data, heart rate, pace, power, and
other performance metrics, and up to 1 year of historical data. This data is used to calculate your fitness
levels, training load, and provide detailed activity analysis. Activities are stored in your Intervals.icu account
and used for charts, calendars, and training reports.

## Wellness Data

We can download wellness metrics such as steps (via daily activity summary), sleep data, sleep scores, resting
heart rate, weight, body fat percentage, blood pressure, menstrual cycle information, and VO2 max estimates, and
up to 1 year of historical data. This wellness data helps track recovery, overall health trends, and inform training
recommendations.

## Planned Workouts

We can upload planned workouts from your calendar to your HUAWEI Health account to be executed on your device.

## Data Storage & Security

All data is stored securely in Europe and is only accessible to you and athletes and coaches you've
explicitly granted access to. We do not share your data with third parties without your explicit consent or use it
for any purpose beyond providing the Intervals.icu service.

You can disconnect your HUAWEI Health account at any time from the settings page. Disconnecting will stop future
data syncing but will not delete historical data already imported into Intervals.icu.`,Hub="Hub",Humidity="Humidity",Hydration="Hydration",icu_rolling_ftp="Estimated FTP is calculated using power curves from <a href='https://www.cyclingapps.net/' target='_blank'>FastFitness.Tips</a> and <a href='https://doi.org/10.1080/00140139608964484' target='_blank'>Morton's 3 parameter critical power model</a>. The algorithm requires just 1 maximal effort of between 180 seconds and 30 minutes. Your estimated FTP will stay the same if you maintain your training load and decline slowly when you reduce training. To get it to go up you need to put in a max effort! The minimum duration required is configured in settings.",ID="ID",Ignore="Ignore",ignore_hr_blurb="Do not use HR for training load, HR curves or totals",ignore_pace_blurb="Do not use pace data for best efforts or pace curves",ignore_part_blurb="Ignore parts of the activity to remove invalid data from the power, pace and/or heart rate curves. These parts will not count towards best efforts and achievements.",ignore_part_blurb2="The portion of the activity currently visible will be ignored. You can ignore multiple parts of the activity. If all the data is bad then use the ignore options in settings.",ignore_part_title="Ignore power, pace or HR for part of the activity",ignore_power_blurb="Do not use power for training load, FTP estimation, power curves or totals",ignore_strava_gear="Do not use gear from Strava",ignore_time_blurb="Do not include time, distance, training load and calories in totals",ignore_velocity_blurb="Do not use velocity data to calculate moving time or time in power zones",ignored_non_fitness_activities="{n} activities have not been included in time in zones because their activity types do not contribute towards cardio fitness",Image$2="Image",Import="Import",import_all_strava_data_blurb="Import your Strava archive. This data is not subject to Strava API restrictions so you can decide who gets to see it!",import_in_progress="{n} import is in progress",import_workout_count="Imported {n}/{tot} workouts",import_workouts_blurb="Click to select {types} files or drag and drop them here. You can select or drop multiple files. Each file will be imported into the folder.",incorrect_password="Incorrect password",Indoor="Indoor",indoor_ftp="Indoor FTP is used for indoor trainer and virtual rides. If left blank then normal FTP is used. - <a href='https://www.bikeradar.com/road/gear/article/ftp-for-cycling-what-functional-threshold-power-means-how-to-test-it-and-how-to-improve-it-48624/' target='_blank' tabindex='-1'>bikeradar.com</a>",INDOOR_TRAINING_text="Indoor Training",INDOOR_TRAINING_title="Ride, run, or row indoors, control indoor trainers",Inj="Inj",Injured="Injured",Injury="Injury",Inline="Inline",INPUT_FIELD_text="Wellness Field",INPUT_FIELD_title="Custom daily wellness field",intensity$1="The intensity of a ride is a measure of how hard it was compared to your FTP. It is calculated by dividing the normalized watts or weighted average power for the ride by your FTP. If you are able to complete a ride of 1 hour or longer at more than 100% intensity then your FTP is too low. For activities without power intensity is derived from the training load and duration.",Intensity="Intensity",Intensity_for_step="Intensity",inter_meso_cycle_progression_rate="Mesocycle-to-mesocycle progression rate",inter_meso_cycle_progression_rate_blurb="Step-up between training blocks",Interval="Interval",interval_display="Interval summaries are displayed with the time or distance (for swimming) followed by average power, pace or heart rate depending on what is available. Use this option to set the priority for the sport.",INTERVAL_FIELD_text="Interval Field",INTERVAL_FIELD_title="Custom field calculated or captured for each interval on an activity",interval_search_blurb="Enter 0 in a field to match any value. The power field accepts a value in watts or a percentage intensity relative to the FTP for each activity. So you can enter 100% to find all the threshold intervals. Click the interval chips for an activity to populate the search parameters to that interval. The thick line shows average power/torque for the matching intervals from activities on each day.",intervals="intervals",Intervals="Intervals",intervals_icu_email_confirmation="Intervals.icu email confirmation",intervals_locked_blurb="Intervals are locked, unlock from {actions} menu",intervals_login_otp="Intervals.icu login OTP",intervals_password_reset="Intervals.icu password reset",intra_meso_cycle_progression_rate="Within-mesocycle progression rate",invert_sub_wellness="Invert subjective wellness scores so 1 is bad and 4 is good",invite_your_friends="Invite your friends and athletes to join you on Intervals.icu by sending them the link below:",IOS_text="iOS App",IOS_title="For iPhones and iPads",Item$1="Item",join_req_msg_sub="{0} asked to join one of your groups",Kayaking="Kayaking",kcal="kcal",kCal="kCal",kcal_consumed="The number of kilocalories (Calories) of food and drink ingested during the day.",Keep="Keep",keep_zone_start_and_end_values="Keep start and end values for zones the athlete already has",Kick="Kick",Kilograms="Kilograms",Kilometers="Kilometers",Kitesurf="Kitesurf",L$4="L",Label="Label",Lactate="Lactate",language="Intervals.icu is busy being translated into many languages. If you would like to help please <a href='https://forum.intervals.icu/t/localisation-of-intervals-icu/4634' target='_blank'>visit the forums</a>.",Language="Language",Lap="Lap",Lat="Lat",Latitude="Latitude",latlng_text="Lat & Lng",latlng_title="GPS latitude and longitude",Leave="Leave",Left="Left",Legend="Legend",Lever="Lever",Library="Library",LIBRARY_scope_description="Your workout library and plans",Lifted="Lifted",Lights="Lights",Limited="Limited",Line="Line",Link$2="Link",link_valid_for_hour="The link is only valid for one hour.",List="List",Load="Load",load_order="Intervals.icu estimates training load from power, heart rate and pace data depending on the data available for the activity. If several of these are available then this setting determines which one is selected. Generally if an activity has power you should use that for load.",Location="Location",Locked="Locked",Login="Login",LOGIN_scope_description="Login to Intervals.icu via a link",login_to_reactivate="{name} needs to login and re-activate their account to see new activities",Logo="Logo",Logout="Logout",Lon="Lon",Longitude="Longitude",Loss="Loss",Low="Low",lr_balance$2="The percentage of power generated from the left and right leg respectively.",lthr$1="Your lactate threshold heart rate is the HR at which your body produces more blood lactate that it can reabsorb. Exercising above this level is only possible for short time periods. See Joe Friel's <a href='http://www.trainingbible.com/joesblog/2009/11/quick-guide-to-setting-zones.html' target='_blank'>cycling and running zones</a> for info on how to estimate lactate threshold HR. If you change your threshold HR you should probably also update your HR training zones.",LTHR="LTHR",lthr_up_0="Your threshold HR has increased to {1} bpm from {2}",lthr_up_0_ui="Threshold HR {value} bpm from {msg}",lthr_up_delta_0="Your threshold HR has increased  by {0} to {1} bpm from {2}",lthr_up_delta_0_ui="Threshold HR +{deltaHR} to {value} bpm from {msg}",lthr_up_message="{0}% of 20m at {1} bpm",lthr_up_message2="1h at {0} bpm",Lunch="Lunch",MAC_text="Mac",MAC_title="Apple laptops and desktops (macOS)",maintenance_apology="We apologise for the inconvenience",maintenance_check_forum="Please visit the <a href='https://forum.intervals.icu' target='_blank'>forum</a> for more information",maintenance_title="Intervals.icu is down for maintenance",maintenance_until="Maintenance should be completed by {t}",Male="Male",manual_activity_blurb="Only create a manual activity to match a planned workout if you did not record the session. Intervals.icu will mark a planned workout as complete automatically when a matching activity is downloaded from your device.",manual_phases_blurb="Manually configure phase durations",map$4="Maximal aerobic power (MAP) is the power at VO2max (maximum oxygen use) for a given test protocol. T-<sub>MAP</sub> is the duration for which this power can be sustained. The values depend on the lab or field test protocol. Intervals.icu uses the power duration curve and the method described in <a href='https://www.fredericgrappe.com/wp-content/uploads/2014/07/MAP.pdf' target='_blank'>Pinot &amp; Grappe 2014</a>. If no value is displayed for a given power curve then the data was not good enough for this methodology. Choose MAP in power chart options to see the regression line and confidence interval described in the paper.",MAP="MAP",mark_complete_title="Mark as complete by creating a manual activity",markdown_help="Use {link} for formatting",marker_locked_msg="Marker is locked, click to unlock",Max="Max",max_file_size_is_n="Max file size is {n}",max_wbal_depletion$1="Riding at power above threshold (FTP) depletes W' (W prime) and it recovers when power output drops under threshold as shown on the W'bal chart. This is the maximum amount that W' was depleted during the ride and matches the lowest point on the chart.",MaxEffort="MaxEffort",maxHr="Your max HR is the highest heart rate you have reached during exercise. If you are unsure use a higher number and use the max HR chart on the fitness page (Options -> Add Chart) to see what the real number is. Heart rates over your max HR are assumed to be spikes and clipped.",Member="Member",menstrual_cycle="The menstrual cycle has an impact on the performance of female athletes. If you capture your period days Intervals.icu will predict your future cycle and you can plan your training accordingly. <a href='https://cyclingtips.com/2015/11/can-your-period-affect-your-performance/' target='_blank'>Read more on cyclingtips.com</a>",menstrual_cycle_perm="This setting controls which Intervals.icu users can see your private wellness data. By default this information is only visible to yourself and your coaches.",Merge="Merge",merge_routes_select_2="Please select exactly 2 routes to merge, no more, no less",message_sent_to="Message sent to {name}",Miles="Miles",Min="Min",Minimal="Minimal",missing_custom_activity_field="The athlete does not have this custom activity field configured",missing_workout_doc="Workout document is missing?",mmp_days="Workout steps can be specified as a percentage of the athlete's mean maximal power (MMP) for a given duration. This is number of days used to compute the model curve for workouts using MMP.",mobile_cols_title="Number of columns on phones",Model="Model",Mon="Mon",Monday="Monday",Monotony="Monotony",Month="Month",Months="Months",Mood="Mood",Morning="Morning",morton_3p_blurb="CP (FTP more or less), W' and pMax are calculated using Morton's 3 parameter critical power model. The algorithm requires 3 maximal efforts, one of 5s, one of 3-5 minutes and another of between 10 and 30 minutes.",Mot="Mot",Motivation="Motivation",Move="Move",Moving="Moving",MPA="MPA",mpa_title="Maximum power available",ms_2p_blurb="CP (FTP more or less) and W' are calculated using Monod & Scherrer's 2 parameter critical power model. The algorithm requires 2 maximal efforts, one of 3-5 minutes and another of between 10 and 30 minutes.",MTB="MTB",must_crop_on_strava="Activities from Strava must be cropped on Strava",Mute="Mute",mute_this_chat="Mute this chat",Muted="Muted",mutual_follow="You are following them and they follow you",N$1="N",n_copied_to_clipboard="{n} has been copied to the clipboard",n_days="{n} days",n_display_settings="{n} Display Settings",n_months="{n} months",n_phase="{n} phase",n_weeks_short="{n}w",n_workout="{n} workout",n_workouts="{n} workouts",n_years="{n} years",Name="Name",name_code_required_for_scripts="You must complete the name and code fields to run scripts",name_zones="{name} Zones",NAVIGATION_text="Navigation",NAVIGATION_title="Navigation and route planning",NE="NE",Neg="Neg",neuromuscular="neuromuscular",New="New",News="News",Newsletter="Newsletter",Next="Next",Nice="Nice",nice_ride="Nice {0}!",Niggle="Niggle",Night="Night",NNE="NNE",NNW="NNW",No="No",no_activities_processed_since="No activities have been processed since {since}",no_activities_selected="Please select some activities to compare",no_calendars_blurb="Intervals.icu can show and analyze training programs from apps that support calendar export for Google, Microsoft, Apple and others",no_coaches_blurb="You do not have any coaches, click any of your followers to make them a coach",no_filters_saved="No filters have been saved, use the save icon to save the filter",no_forecasts="No forecasts found, click Add Forecast to create one",no_gear_blurb="You do not have any bikes, shoes or other gear",no_matching_activities_with_found="No matching activities with {p} found",no_targets_blurb="Click the buttons below to set training load, time and distance targets for your sports. You can track progress against the targets and plan your training to achieve them.",no_upcoming_races_found="No upcoming races found. Add a race to get started.",no_user_with_email="No user is registered with that email address",no_workout_steps="Workout has no suitable steps",non_members_visible_blurb="Non-members can see the group but not chat messages, workouts or training plans",None$1="None",Norm="Norm",Normal="Normal",Normalized="Normalized",Not$1="Not",Note="Note",Notes="Notes",Notifications="Notifications",now_coaching_group_msg="You belong to the group '{0}' which is now a coaching group. All current and future admins and coaches in the group will be able to see and update your data. This makes it easier for teams and coaching businesses to manage their athletes. Are you happy with this? Only answer Yes if you trust the group admins.",Numeric="Numeric",NUTRITION_text="Nutrition",NUTRITION_title="Adaptive meal planners, food tracking",NW="NW",Offset="Offset",ofn="of {n}",Ok="Ok",OK="OK",Ok_wellness="Ok",old_wellness_data_blurb="Wellness data from the start date will be downloaded. It will take many minutes to appear on your calendar. Please be patient.",old_wellness_data_download_busy="Wellness data is being downloaded, please be patient",Older="Older",one_day="1 day",Opacity="Opacity",Open="Open",open_step_duration_blurb="Some workout files (e.g. fit files exported from TP) include steps with no duration (Open). Intervals.icu requires all steps to have a duration so it can calculate training load. Enter zero to leave these steps out.",Operator="Operator",Optimal="Optimal",Options$1="Options",original_file="Original {type} File",Other="Other",Others="Others",otp_email_sent="An OTP email has been sent to {0}, if you don't see it please check your spam folder",otp_has_been_used="OTP has already been used",otp_has_expired="OTP has expired, please request a new one",Outdoor="Outdoor",outdoor_power_range="Outdoor workout steps with exact power targets are converted into ranges of plus/minus this percentage of the target power",overlay_confirm_clear="Are you sure you want to remove all activities?",Overview="Overview",Ovulating="Ovulating",ovulating_title="Menstrual cycle ovulation days",p_max_blurb="Pmax represents the highest instant power that can be produced for a very short duration. This should be set to the athlete's best {n} second power.",Pace="Pace",pace_load_type="Intervals.icu can estimate training load from pace for swimming and gradient adjusted pace for running. This might be a better measure than load from heart rate. The running calculation is explained in <a href='https://forum.slowtwitch.com/forum/Slowtwitch_Forums_C1/Triathlon_Forum_F1/Running_TSS_formula_clarification_P5374893/' target='_blank'>this Slowtwitch post</a>. The swim calculation is <a href='https://www.trainingpeaks.com/learn/articles/calculating-swimming-tss-score/' target='_blank'>explained here</a>.",pace_prompt="Capture your threshold pace and pace zones for {sportName} in settings to enable pace analysis",pace_prompt_other="Create a new sport or add {typeName} to an existing sport with pace in settings to enable pace analysis",pace_range="Workout steps with exact pace targets are converted into ranges of plus/minus this percentage of the target pace",pace_units_for_athlete="{du} for {n}",Paddle="Paddle",Padel="Padel",page_under_development='This page is under development. If there are pace related things you would like to see here, please ask on the <a href="https://forum.intervals.icu" target="_blank">forums</a>.',pair_with_event_blurb="Try to find a planned workout or race for each activity",paired_with_activity="Workout has already been paired with an activity (completed)",Pairing="Pairing",Panel="Panel",Password="Password",password_has_been_reset="Your password has been reset",password_reset_expired="Password reset token has expired, try login to get a new one",password_reset_sent="A password reset email has been sent to {0}, if you don't see it please check your spam folder",Past="Past",past_days="Previously uploaded workouts this many days in the past will be deleted",Paste="Paste",paste_chart_blurb="Copy charts to the clipboard using the copy button on the chart settings window and send them to your friends. Paste charts you get from others here.",PCr="PCr",pcr_stream_title="Alactic energy system contribution",Peak="Peak",peak_phase_weeks="Peak Phase (weeks)",Pedals="Pedals",Percent="Percent",Percentage="Percentage",percentage_of="Percentage of {n}",percentage_of_ftp_blurb="Percentage of the athletes functional threshold power",percentage_of_mmp_blurb="Percentage of the athletes mean maximal power for a given duration (default is the step duration)",Period="Period",period_title="Menstrual cycle period days",PI="PI",pick_target_race="Select races to include and pick target race (where plan ends)",Pickleball="Pickleball",Pilates="Pilates",placing_plan_on_calendar="Placing plan on calendar...",Plan="Plan",plan_changes_applied_one_athlete="Plan changes applied to one athlete",plan_changes_applied_to_athletes="Plan changes applied to {n} athletes",plan_end_race="The plan will end on this race",plan_for_week_sent="Plan for the week email sent",plan_moved_successfully="Plan {n} moved successfully",plan_not_shared_with_athletes="This plan is not shared with any athletes",Planned="Planned",Plans="Plans",Platform="Platform",Platforms="Platforms",please_add_me_to_group="Please add me to {0}, thanks!",please_capture_dob="Please capture your date of birth to view age based rankings for power! How do you compare to your peers?",please_coach_me="Please coach me!",please_describe_problem="Please describe the problem you are having or the cool new feature you have thought of and I will see what I can do.",please_do_not_share="Please do not share plans and workouts that do not belong to you",please_login_at="Please login at {0}",please_select_target_race="Please select a target race to continue",please_unlock_intervals="Intervals are locked. Please unlock intervals to make changes.",Plot="Plot",plot_calendar_options_blurb="Choose how this plot is displayed on the calendar",plotly_script_title="Plotly chart created with Javascript",Pmax="Pmax",Points="Points",Polar="Polar",polar_import_complete="Polar data import complete",POLAR_text="Polar",POLAR_title="Polar watches and other devices",polarization_index_blurb="The polarisation index (PI) is calculated from the time spent in low, mid, or high intensity training. It makes it possible to distinguish between non-polarized and polarized training intensity distributions with a higher PI indicating a more polarized distribution. A PI of 2 or more is considered polarized.",Polarized="Polarized",Pool="Pool",Poor="Poor",Pos="Pos",Position="Position",Pounds="Pounds",power="power",Power="Power",Power2="Power2",power_alt_acc_help="Athletes produce less power altitude because there is less oxygen available. This trace adjusts for this to show what power might have been produced at sea level. The athlete is assumed to be acclimatized (several weeks at altitude). <a href='https://alex-cycle.blogspot.com/2014/12/' target='_blank'>Bassett et al formula</a>",power_alt_help="Athletes produce less power altitude because there is less oxygen available. This trace adjusts for this to show what power might have been produced at sea level. The athlete is assumed to be unacclimatized (1-7 days at altitude). <a href='https://alex-cycle.blogspot.com/2014/12/' target='_blank'>Bassett et al formula</a>",power_at_bpm="Power {'@'}{bpm} bpm",power_field_blurb="Activity fit files may contain several different fields with power data (e.g. Garmin running power and Stryd power). Choose the field to use for this activity and optionally also for future activities for the same sport.",power_field_title="Source of power data",power_hr_chart_blurb="This chart shows the same HR and power data but the x-axis is the power for each minute and y-axis the corresponding heart rate. The lines show the relationship between power and heart rate for the first half and second half of the ride.",power_hr_chart_blurb2="This chart shows the power / HR ratio for each minute of your ride. The heart rate for each power point is shifted to account for the fact that when you put the power down there is a delay in HR response (lag).",power_hr_curve_chart_blurb="As you get fitter the power you can produce at a given heart rate will increase. This is evident by a trace further to the right on this chart. If you compare two traces then the difference between them in watts at the same heart rate is displayed on the marker.",power_hr_minutes_excluded="Minutes with less than 30s moving time are excluded from both charts.",power_hr_trace_blurb="Power is a 60s moving average as a percentage of {eftpLabel} while heartrate is shown as percentage of HR reserve (max HR - resting HR). Decoupling is a 10m moving average of the power/HR ratio relative to the ratio for the first half or hour of the ride whichever is shorter. Negative decoupling is not displayed. Cadence is a 60s moving average.",power_hr_z2$1="This is your average watts / average heart rate for the parts of your ride done in HR zone 2 (aerobic or endurance). The ride is split up into 1 minute sections adjusted for HR lag. Only minutes in HR Z2 with cadence within 92% and 115% of the median for the Z2 points are kept. The power/HR Z2 ratio is the average of these minutes and an indicator of aerobic fitness.",power_model_chart1="Power more than {threshold}% above the",power_model_chart2="model power duration curve for your FTP is",power_model_chart3="probably a spike and is fixed",power_model_chart_under="Power under the model power curve for your FTP is likely real",power_profile_blurb="This chart shows your watts/kg or watts for some standard durations and estimated FTP compared to Intervals.icu athletes in the selected group. The percentage scale indicates how many athletes have max power less than the value at that position on the chart for the given duration.",power_profile_type_blurb="The shape of the lines on the chart indicates what type of rider you are.",power_prompt="Capture your FTP and power zones for {sportName} in settings to enable power analysis",power_prompt_other="Create a new sport or add {typeName} to an existing sport with power in settings to enable power analysis",power_spike_help1="Power spikes are detected by comparing your power output to what you should be capable of based on the power duration curve for your FTP.",power_spike_help2="You can see the unmodified power for a ride by clicking Charts on the timeline and adding Raw Power. Also consider raising your FTP if many spurious spikes are being detected.",power_spike_threshold="Power spikes are detected and fixed by comparing your power output to what you should be capable of based on the FTP for the ride. If your power output for a given duration is more than the power spike threshold percentage above the power curve for your FTP then that is considered a spike and fixed. You can see the unmodified power trace by clicking Charts on the ride timeline and adding Raw Power. Also consider raising your FTP if many spurious spikes are being detected.",Prefix="Prefix",Premium$1="Premium",premium_feature="Premium feature",premium_feature_blurb="{feature} is a premium feature, please subscribe and support Intervals.icu!",premium_feature_blurb_other="{name} needs to be a supporter for {feature}, please encourage them to subscribe",premium_feature_thanks="Premium feature, Thanks!",premium_feature_thanks_other="{name} is a supporter and has access to {feature}",premium_star_title="{name} is a premium feature, click for more info",Pressure="Pressure",Priority="Priority",Privacy="Privacy",privacy_circles_blurb="Define privacy circles to obscure your home, work and other parts of activities from maps",privacy_settings_blurb="Intervals.icu accounts are private by default and only your followers can see your activities and data",Private="Private",Profile="Profile",Progress="Progress",progression_plateau="Progression plateau",progression_plateau_blurb="Longer plans plateau earlier",Prompt="Prompt",Protein="Protein",Protein_g="Protein(g)",Public="Public",puncheur="Rolling terrain with short steep climbs is your thing, no-one can match you for 5 minutes (Alaphilippe)",Puncheur="Puncheur",puncheur_blurb="Rolling terrain with short steep climbs is your thing, no-one can match you for 5 minutes (Alaphilippe)",Purchased="Purchased",Pyramidal="Pyramidal",R="R",Race="Race",race_based_blurb="Auto-generate phases based on upcoming races",race_intensity="race intensity",race_pace="race pace",race_preparation="race preparation",race_simulation="race simulation",Races="Races",Racquetball="Racquetball",Radius="Radius",Rain="Rain",Ramp="Ramp",ramp_rate$1="Weekly ramp rate is how much your fitness changes from week to week. If it is positive, you are getting fitter. During recovery weeks it will be negative. If your ramp rate is too high you run the risk of becoming overtrained - <a href='https://joefrielsblog.com/the-ctl-ramp-rate/' target='_blank'>joefrielsblog.com</a> ",Ranges="Ranges",raw_watts_blurb="Power without spike correction",reactivate_account_prompt="Would you like to re-activate your account? You can recover missing activities for most integrations on the settings page.",Read="Read",Readiness="Readiness",reanalyze_for_weather="This activity needs to be re-analyzed for weather analysis. This can be done by {name} or one of their coaches",rebuilding_power_curves="Rebuilding power curves, this may take a few minutes",Recalculate="Recalculate",Record="Record",record_blurb="Stream created from field values in record messages",RECORDER_text="Recorder",RECORDER_title="Record activities for upload to Intervals.icu",recording_time_for_moving_time="The recording time of the device will be used for moving time. This is useful for sports like tennis and mountain climbing where GPS speed data is not useful",Recovery="Recovery",recovery_week_blurb="Focus on easier efforts, reduced volume, and allowing your body to adapt to training stress",recovery_week_interval="Recovery every (weeks)",recovery_week_volume_reduction="Recovery week volume reduction",Redo="Redo",Ref="Ref",References="References",Refresh="Refresh",Region="Region",reminder_blurb="Reminders notify you after a certain amount of usage or number of days has passed",reminder_usage_since="Usage calculated since {d}",Reminders="Reminders",Remove="Remove",removed_folder0="Removed folder {0}",removed_plan0="Removed training plan {0}",Rename="Rename",Repeats="Repeats",Replace="Replace",reply_on_intervals_icu="Reply on Intervals.icu",reprocess_file_blurb="All activity streams (power, heart rate, pace etc.) will be recomputed and any edits or cropping will be undone",reprocess_on_new_stream_prompt="Existing activities need to be reprocessed to pickup data for new custom streams. Would you like to reprocess this activity now?",Reprocessing="Reprocessing",Reproductive="Reproductive",Reps="Reps",req_data_from_garmin_after_blurb="Intervals.icu will email you when processing is complete. If you don't tick any of the boxes nothing will be done and you can review what was found.",req_data_from_garmin_blurb='You can <a href="https://www.garmin.com/en-US/account/datamanagement/" target="_blank">request all of your data from Garmin</a>. Make sure that you are logged into the correct Garmin account. Note that it may take several days for Garmin to get back to you. Copy and paste the download link from Garmin into the field below:',req_data_from_polar_blurb=`Follow <a href='https://support.polar.com/en/how-to-download-all-your-data-from-polar-flow' target='_blank'>these instructions</a> to request all of your data from Polar. When the download is ready, right click the "Download" button, choose "Copy Link" and paste in the field below.`,req_data_from_strava_after_blurb="Activities already on Intervals.icu will not be duplicated. Strava API activities will be replaced and comments, intervals, etc. copied over. Intervals.icu will email you when processing is complete.",req_data_from_strava_blurb='You can <a href="https://www.strava.com/athlete/delete_your_account" target="_blank">request all of your data from Strava</a>. Make sure that you are logged into the correct Strava account. It may take several hours for Strava to email you a link to the archive. You do not need to delete your account! This data is not subject to the Strava API restrictions. Right click the button in the email and copy and paste the download link into the field below:',request_otp_blurb="If you do not have an Intervals.icu password or can't remember your password you can login using an OTP sent to your email address",Required="Required",Resend="Resend",Reset="Reset",reset_eftp_description="Reset your estimated FTP. This is useful after a long break when you know your FTP has dropped by more than the usual decay rate and you want to start seeing FTP up achievements again!",Respiration="Respiration",respiration_title="Breathing rate per minute",Rest="Rest",Resting="Resting",resting_hr$1="Your resting heart rate is your HR first thing in the morning before you get up. It is an indicator of fitness and general health. Stress, poor sleep and illness will generally cause it to increase. Intervals.icu uses your resting HR when calculating training load using HRSS.",Retire="Retire",Retired="Retired",Retry="Retry",Ride="Ride",Right="Right",Rollout="Rollout",Rotor="Rotor",round_zones_down="Round computed zone start and end down to an integer",Route="Route",route_add_tags_to_activities="Tags to add to activities",route_has_been_deleted="This route has been deleted and replaced by {replacedBy}",route_rename_activities="Use name for activities on this route",route_replaces="This route replaces the following routes",routes="Activity route tracking",Routes="Routes",routes_blurb="Route matching. Track your progress, auto flag commutes and rename activities",routes_not_similar_enough="These routes are only {p} similar, that is not close enough to merge them",Row="Row",Rowing="Rowing",Rows="Rows",rpe$1="Rate of Perceived Exertion (RPE) is used to measure the intensity of exercise on a 1 - 10 scale. How did it feel?",RPE="RPE",RPM="RPM",Rugby="Rugby",Run="Run",S="S",Saddle="Saddle",Sail="Sail",sample_size="There are <b>{n}</b> athletes in this group.",Sat="Sat",Saturday="Saturday",Save="Save",Saved="Saved",Scale="Scale",Screenshot="Screenshot",Script="Script",script_blurb="JavaScript code to calculate the field value",script_returned_no_value="Script did not return a value object",SE="SE",Search="Search",Season="Season",Seasons="Seasons",Seatpost="Seatpost",secondary_power_blurb="Alternate (secondary) power",Seconds="Seconds",secret_sauce="Secret sauce ~ This script has been hidden by its author",See="See",Seen="Seen",Segment="Segment",Select="Select",select_at_least_one_target_type="At least one target type must be selected",Selected="Selected",selected_file_imported_on_change="The selected file will be re-imported when it changes",Send="Send",send_coach_tick="When a coach ticks one of my activities",send_link_blurb="Send them <a>a link to join</a> Intervals.icu",send_link_long_blurb="Invite your friends to join you on Intervals.icu by sending them this link. You will receive a message when they signup and they can request to follow you",send_msg_to_ask_coach_for_help="If you send a message they will be able to see your Intervals.icu data and might be able to help you.",send_to_n="Send to {n}",sent_group_chat_msg_sub="{0} sent a message to '{1}'",sent_message_msg_sub="{0} sent you a message",session_count$1="Session Count",session_count_title="Number of sessions on day",session_rpe$1=`Session-RPE is a method of quantifying training load by considering the intensity (RPE) and duration of the training session (or competition). The athlete selected RPE value is multiplied by the session-duration in minutes to produce a unit-less training load number - <a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5673663/" target="_blank">Validity, Ecological Usefulness, and Influencing Factors</a>
`,set_password_for_account="Set a password for your account so you can login using your email address",Settings="Settings",SETTINGS_scope_description="Your athlete settings",Sex="Sex",Share="Share",share_events_blurb='You can share your own races and planned workouts with everyone, just click the event on your calendar and choose "Share"',share_folder_with_athletes="Share {name} With Athletes",share_image_unsupported_browser="It seems your browser does not support image capture. Please try Chrome or Firefox.",share_plans_folders_profile_blurb="You can share plans and folders with everyone on your profile page",share_screenshot_blurb="Share screenshot on Strava or download",Shared="Shared",shared_event_added="{n} added to calendar",shared_event_created="{n} has been created, thank you!",shared_event_forecast_note="Weather forecast data appears between 7 and 14 days before the event",shared_event_image_placeholder="Event Image (ideal size 1200x630)",shared_events_visible_on_www="Shared events are visible to everyone on {link}",shared_folder0="Shared folder {0}",shared_plan0="Shared training plan {0}",sharpening="sharpening",she="she",Shock="Shock",Shoes="Shoes",Show="Show",Showers="Showers",showing_data_from_to="Showing data from {start} to {end}",Shrink="Shrink",Sick="Sick",Signup="Signup",signup_auto_download_blurb="Intervals.icu can automatically download activities and wellness data from many devices or you can manually upload .fit, .gpx and .tcx files yourself.",signup_confirm_email_sent="A confirmation message has been sent to {email}. Please look out for it to confirm your email address.",signup_link_dropbox_blurb="Link your Dropbox account and add a download folder. This is how you can get activities from Wahoo, TrainerRoad and other sources that support Dropbox into Intervals.icu.",signup_link_garmin_blurb="Link your Garmin Connect account to analyse your activities on Intervals.icu. Note that activities not from Garmin devices are not supplied to Intervals.icu. Use Dropbox for those.",signup_link_later_blurb="If you don't want to do this now, click 'Skip' to continue to Intervals.icu. You can link accounts later in settings.",signup_link_strava_blurb="Connect your Strava account to analyse your activities on Intervals.icu. Note that if you revoke Intervals.icu access or Strava requires us to do so, then Intervals.icu will delete all data originating from Strava.",signup_promo_blurb="Level up your training with advanced sports analytics and planning from Intervals.icu!",signup_promo_congrats="Congratulations, you are now a premium member of Intervals.icu until {until}!",signup_promo_offer="Three months of premium membership is included, no payment information required.",signup_thank_you="Thank you for signing up, {name}!",Size="Size",Skateboard="Skateboard",Skis="Skis",skyline_chart_title="Skyline chart of intervals",Sleep="Sleep",slow_connection_blurb="This is normally caused by restrictive corporate network policies or anti-virus software. If you are running anti-virus software, configure it to allow WebSocket connections or disable it for Intervals.icu",slow_connection_warning="Intervals.icu was unable to establish a fast connection to the server",smart_recording_warning='This activity has been recorded with approximately {secs} seconds per data point. Intervals.icu works best with a data point every second. Please disable <a href="https://www.cnet.com/how-to/the-one-setting-you-should-change-on-your-garmin-watch/" target="_blank">smart recording</a> on your device if possible.',SmO2="SmO2",Snow="Snow",Snowboard="Snowboard",Snowshoe="Snowshoe",Soccer="Soccer",social_networks_blurb='Follow us, join our Strava club and <a href="https://forum.intervals.icu" target="_blank">forums</a> to find out about and discuss new features!',Sore="Sore",Soreness="Soreness",Source="Source",Spacing="Spacing",Speed="Speed",speed_units_help="Speed is in meters/second",SPI="SPI",Split="Split",split_interval_blurb="Split the interval into pieces all with the same time or distance",SpO2="SpO2",Sponsor="Sponsor",Sport="Sport",sport_settings_combined_time_in_zones="Intervals.icu reports on combined time in zones. This works best if you have the same number of zones for power, HR and pace and the zones are comparable.",sport_settings_fields_blurb="Custom activity field values copied onto new activities for this sport",Sports="Sports",sports_settings_other_blurb="These settings are used for activities that do not match any other sports",Spreadsheet="Spreadsheet",Sprinter="Sprinter",sprinter_blurb="You are an explosive finisher, assuming you can make it to the end of the race (Cipollini)",Squash="Squash",SS="SS",ss_cp_title="Aerobic strain score",ss_p_max_title="PCr strain score",ss_w_prime_title="Glycolytic strain score",SSE="SSE",SSW="SSW",Stack="Stack",stack_blurb="Bar plots with the same stack value are placed above each other instead of overlapping",Start="Start",started_chat_msg_sub="{0} started a chat with you",State="State",Stats="Stats",Stem="Stem",Steps="Steps",Str="Str",Strain="Strain",strain_score_help="Strain Score (SS, similar to XSS in Xert), is a power based training load metric that considers time spent above the maximal metabolic steady state to estimate the level of strain for the activity. The algorithm quantifies the contribution from each energy system (oxidative, glycolytic and sprint/PCr) as SS CP, SS W' and SS Pmax respectively.",strain_score_parts_title="Strain Score parts",strain_score_title="Similar to XSS in Xert",strain_score_title2="SS load metric",strain_stream_title="Strain rate",Strava$1="Strava",strava_api_restrictions="NB: Strava API restrictions!",strava_api_restrictions_blurb='The <a href="https://www.strava.com/legal/api" target="_blank">Strava API terms of service</a> prohibit Intervals.icu from showing activities obtained via the API to your Intervals.icu followers. Only your coaches can see them. If you want to have full control over your data, connect the source directly to Intervals.icu and keep Strava connected. Intervals.icu will replace Strava activities with the original and link the original to Strava.',strava_api_restrictions_blurb2="You can also use the {btn} button to process the file Strava emails you when you request all of your data. These activities are not subject to the API terms of service.",strava_description_update_warning="Note that the description shown on Strava will be updated",strava_elevation_blurb="Elevation data from Strava is very accurate even from devices without a barometric altimeter, using elevation correction is not recommended",strava_history_supporter_note="Please note that you need to subscribe and become a supporter to retrieve more than 3 months of history from Strava",strava_import_complete="Strava import complete",strava_sync_disabled="No activities are being downloaded from Strava",strava_sync_only_supporters="Strava synchronisation is only available to supporters",strava_sync_other_activities="Keep non-Strava activities in sync with Strava",strava_update_permission_missing="Intervals.icu does not have permission to update your Strava activities!",strava_visibility_update="Strava activity visibility update",strava_visibility_update2="Strava visibility update: Coaching is ok!",Stream="Stream",stream_formula_help="Math expression using plot names as variables",stream_script_blurb="JavaScript code to calculate the value for each point in the stream ",Streams="Streams",Stress="Stress",Stride="Stride",Strong$2="Strong",structure_read_only="Can be moved or deleted but not edited",sub_type_blurb="Commute, race, warmup, cooldown etc.",Subscribe="Subscribe",subscribe_on_settings_page="You can <a href='https://intervals.icu/settings?sub=true'>subscribe on the settings page</a>.",Subscription="Subscription",subscription_past_due_banner="Your subscription is past due, please check your payment details on the <a>billing portal</a>. Thank you for your support!",Suffix="Suffix",Sum$1="Sum",Summary="Summary",Sun="Sun",Sunday="Sunday",supporter_download_unlimited_blurb="Thank you for supporting Intervals.icu! As a supporter you can download unlimited historical data from {source}.",supporter_feature_requests="Supporter feature requests move up the todo list!",Surfing="Surfing",Suunto="Suunto",SUUNTO_text="Suunto",SUUNTO_title="Suunto watches and other devices",suunto_upload_filters_blurb="Add filters to select which planned workouts will be uploaded to Suunto. Workouts for the next week are uploaded.",SW="SW",Swap="Swap",Swim="Swim",Sync="Sync",SYNC_ACTIVITIES_text="Activity Sync",SYNC_ACTIVITIES_title="Sync activities to/from other platforms",SYNC_WELLNESS_text="Wellness Sync",SYNC_WELLNESS_title="Sync weight, resting HR and other wellness data to/from other platforms",SYNC_WORKOUTS_text="Workout Sync",SYNC_WORKOUTS_title="Sync planned workouts to/from other platforms",Systolic="Systolic",Table$2="Table",tableAgg_avg_help="Average the value of the column for each day in the group",tableAgg_max_help="Select the maximum value for the column in the group",tableAgg_min_help="Select the minimum value for the column in the group",tableAgg_sum_help="Total the value of the column for each day in the group",tableAgg_sum_inputs_help="For columns using a custom formula: Sum the values of each input field for each day in the group, then evaluate the formula using those sums to compute the group value",Tags="Tags",Tailwind="Tailwind",taper="taper",Target="Target",Targets="Targets",Temp="Temp",Temperature="Temperature",tempo="tempo",Tennis="Tennis",Text$2="Text",text_align_blurb="Choose how text is aligned in columns on grid views",text_wrap_blurb="Control how text is wrapped in columns on grid views. The 'Pre-wrap' option preserves line breaks in the text",THb="THb",their="their",them="them",they="they",threshold="threshold",Threshold="Threshold",threshold_pace$1="Your threshold pace is the speed you can maintain for a 'long' time (definition depends on the sport) measured in time per distance unit. For running this might be the fastest you have been able to run for 30 minutes. It is used to calculate training load from pace. See <a href='https://joefrieltraining.com/a-quick-guide-to-setting-zone/' target='_blank'>Setting Zones by Joe Friel</a>",Thurs="Thurs",Thursday="Thursday",tick_both_boxes="Both boxes must be ticked:",tidal_volume_min_title="Breathing volume per minute",tidal_volume_title="Volume per breath",Time="Time",Time_duration="Time",time_in_custom_zone$1="Time in Custom Zone",time_in_zones="Time in {n} zones",time_in_zones_hr_load_blurb="Your previous activities with power and heart rate are used to build a linear regression model to estimate training load.",time_trialist_blurb="You can do kilometer after kilometer on the front and do not feel pain (Tony Martin)",Timeline="Timeline",timezone="Some activity files (e.g. from Zwift) do not contain timezone information. This is the timezone used for activities without timezones.",Timezone="Timezone",Title="Title",tiz_class_title="Time in zones classification",tiz_order="Intervals.icu uses time in zones from power, heart rate or pace for totals depending on the data available for the activity. If several of these are available then this setting determines which is selected. Generally if an activity has power you should use that for time in zones.",to="to",Today="Today",Tomorrow="Tomorrow",too_old_for_weather="This activity is too old for weather analysis. Historical weather forecast data is only available from {oldest} onwards.",Top="Top",Torque="Torque",Total="Total",Totals="Totals",TRACE_CHART_text="Trace Chart",TRACE_CHART_title="Custom trace chart on the activity timeline",Track="Track",Trainer="Trainer",Training="Training",training_load="Training load is an estimate of how hard a given activity was relative to the athletes capabilities. For activities with power it depends on the intensity of the session (relative to FTP) and duration. 1 hour at 100% of FTP is 100 training load (see <a href='https://www.sciencetosport.com/monitoring-training-load/' target='_blank' tabindex='-1'>www.sciencetosport.com</a>). Intervals.icu can also estimate training load using heart rate and gradient adjusted pace. The priority of different training loads and the models used are configurable in settings.",training_plan_help="A plan can have any number of weeks. More weeks are automatically added when you add workouts to the top of the plan. You can drag and drop a plan onto an athlete's calendar to schedule workouts. You can also link athletes to a plan and apply changes to the plan to all of their calendars with one click. Only workouts from today onwards are updated.",Transition$1="Transition",Transition_sport="Transition",trial_ended_p1="Intervals.icu is free to use but some features require a subscription after a {0} day free trial period. Your free trial has ended. Please subscribe to continue using premium features like Strava download and to support the development of Intervals.icu!",trial_ended_subject="Intervals.icu free trial ended",trial_ending_soon_p1="Intervals.icu is free to use but some features require a subscription after a {0} day free trial period. Your trial will be ending on {1}. Please subscribe to continue using premium features like Strava download and to support the development of Intervals.icu!",trial_ending_soon_subject="Intervals.icu free trial ending soon",trimmed_week_alert="{n} week(s) will be trimmed from end to fit date range",trimp$1="Training Impulse points according to Morton/Banister with Green et al coefficient. This is a measure of training load derived from the average HR for the activity relative to resting HR and max HR and the moving time - <a href='https://www.researchgate.net/publication/20910238_Modeling_human_performance_in_running' target='_blank'>Modelling human performance in running</a>",TRIMP="TRIMP",tte="Time to exhaustion (TTE) as used here, is the maximum duration that FTP or critical power (CP) can be maintained. This is only valuable if you have actually tried to see how long you can ride at your FTP or CP - <a target='_blank' href='https://help.trainingpeaks.com/hc/en-us/articles/360030945391-Introduction-To-The-Time-To-Exhaustion-TTE-Metric-In-WKO'>The-TTE-Metric</a>",TTE="TTE",Tube="Tube",Tues="Tues",Tuesday="Tuesday",Type="Type",Tyre="Tyre",Unavailable="Unavailable",Unconfirmed="Unconfirmed",Undelete="Undelete",Undeleting="Undeleting",Undo="Undo",Unique="Unique",Units="Units",unknown_service="Unknown service {name}",Unmute="Unmute",Unplanned="Unplanned",Unretire="Unretire",unsub_update_email_settings="Unsubscribe or update Intervals.icu email preferences",unsupported_workout_type="Unsupported workout type",Up="Up",Update="Update",update_activity_name_from_workout_blurb="Intervals.icu updates the name of a completed activity to match the planned workout name when an activity is paired with a planned workout. Use this setting to control that behaviour.",update_email_settings="Update Intervals.icu email preferences",Update_n="Update {n}",Update_n_failed="Update {n} failed",update_specific_activities_blurb='If you need to update specific activities or activities matching a date range please use the <a href="https://forum.intervals.icu/t/activities-page-a-guide-to-getting-started/17698/3" target="_blank">activity list view</a>.',update_strava_name="Update Strava name and description",Updated="Updated {n}",Upload="Upload",upload_activity_blurb="Click to select FIT, GPX, TCX, GZ and/or ZIP files or drag and drop them here. For zip files all supported file types found in the archive are imported. You can select or drop multiple files.",upload_activity_csv_blurb="You can edit the CSV and upload it to fix data. Click to select a CSV file to upload or drag and drop one here.",upload_activity_problems_blurb='Note that .fit files can contain all sorts of weirdness. Please report problems on the <a href="https://forum.intervals.icu" target="_blank">forums</a>.',upload_attachment_blurb="Click to select a file or drag and drop a file here",upload_filters_blurb="Add filters to select which planned workouts will be uploaded to {n}.",upload_lang_blurb="Drag and drop {file} file here to use the translation in Intervals.icu. Changes are discarded when Intervals.icu is reloaded.",upload_shared_event_image_blurb="Upload an image for this event to make the listing stand out, ideal size 1200x630",upload_streams_csv="Uploading activity streams CSV",upload_streams_csv_blurb="Upload activity stream data (power, heart rate etc.) in CSV format to add and/or edit data",upload_wellness_csv_help="Click to select a CSV file or drag and drop one here. Columns must have the same names as in the wellness CSV download. Empty cells are ignored. Use yyyy-mm-dd for dates, -1 in numeric fields to clear and NONE to remove menstrual phrase information.",upload_workouts_dropbox_blurb="Upload planned workouts to Dropbox folders",Uploading="Uploading",URL$1="URL",use_gap_zone_times="When the training load for an activity is calculated from pace then pace is used for 'time in zones' for the activity. The pace time in zones is calculated using gradient adjusted pace or normal pace.",use_markdown_and_ftp="Use markdown and %FTP/HR",use_otp_as_password="Use this code as a password to login",use_otp_to_login="You do not have a password, please request an OTP to login",user_has_no_password="The user with that email address has no password set, please click 'Connect with Strava' to login",Users="Users",UVI="UVI",validation_max="Must be <= {n}",validation_min="Must be >= {n}",Value$1="Value",VAM="VAM",Var="Var",Variability="Variability",variability_index="Variability Index is a way to measure how smooth or variable your power output was during the ride. It is calculated by dividing your normalized watts by your average power. A steady and even output, like during a triathlon, should have a VI of 1.05 or less. During a criterium race your VI may be as high as 1.2 or more - <a href='https://www.trainingpeaks.com/blog/power-terminology-for-cycling/' target='_blank'>www.trainingpeaks.com</a>",Velomobile="Velomobile",Version="Version",view_strava_segments="View Strava segments on matching non-Strava activities (e.g. from Garmin Connect)",view_week_n_overview="View week {n} overview",Viewer="Viewer",Visibility="Visibility",visibility_blurb="Intervals.icu accounts are private by default. People on the platform have to ask to follow you to see your data. However your name, profile picture and location are displayed in athlete searches so people can find each other. If you change your visibility to Hidden then you only appear in searches to those already following you and people with groups in common with you.",visibility_followers_blurb="{n} is only visible to your followers",visibility_private_blurb="{n} is only visible to athletes you share it with",visibility_private_hidden_blurb="{n} is only visible to yourself",visibility_public_blurb="{n} is visible to everyone and will appear on your profile",vo2max$1="vo2 max",vo2max_5m="V̇O2 max is the maximum rate of oxygen consumption and is usually displayed in ml per kg of body weight. Accurate measurement of VO2 max requires a graded exercise test in a lab with a metabolic cart. The estimate displayed here is derived from 5 minute peak power output using a formula from <a href='https://journals.humankinetics.com/view/journals/ijspp/17/1/article-p9.xml' target='_blank'>5 min Test to Predict Maximal Oxygen Consumption in Road Cycling</a>",W$1="W",w_prime$1="Anaerobic Work Capacity or W' (W prime) is the amount of energy in Joules you have available when riding above threshold (FTP). It is a short term energy source that uses non-aerobic (non oxygen) pathways - <a href='https://www.pezcyclingnews.com/toolbox/the-anaerobic-w/' target='_blank'>pezcyclingnews.com</a>",Wahoo="Wahoo",WAHOO_text="Wahoo",WAHOO_title="Wahoo cycle computers, indoor trainers and other devices",Walk="Walk",Warmup="Warmup",warmup_time="Intervals.icu excludes the first few minutes of an activity (warmup) when calculating decoupling. This is the default warmup time for new activities.",warn_set_password="Note that you need to set a password before revoking access or you will not be able to login to Intervals.icu",WATCH_OS_text="Apple Watch",WATCH_OS_title="Apple watch",Watts="Watts",watts_30s_blurb="30s moving average on a log scale",wattsBpm="Also known as output / input ratio, a measure of how much output (watts) you produce for a given input (heart rate measured in beats/minute). As you get fitter this number should go up though there are many confounding factors that influence HR. Best to look at this for endurance rides. See <a href='https://joefrielsblog.com/speed-power-heart-rate-and-fitness/' target='_blank'>Joe Friel's blog</a>.",Wbal="W'bal",Weak="Weak",WEAR_OS_text="Wear OS",WEAR_OS_title="Samsung (Galaxy), Google and Fossil watches",Weather="Weather",weather_analysis_blurb="Advanced {link} on outdoor activities",weather_Clear="Clear",weather_Cloudy="Cloudy",weather_Drizzle="Drizzle",weather_Foggy="Foggy",weather_FreezingDrizzle="Freezing Drizzle",weather_FreezingRain="Freezing Rain",weather_HeavyDrizzle="Heavy Drizzle",weather_HeavyRain="Heavy Rain",weather_HeavyShowers="Heavy Showers",weather_HeavySnow="Heavy Snow",weather_LightDrizzle="Light Drizzle",weather_LightFreezingDrizzle="Light Freezing Drizzle",weather_LightFreezingRain="Light Freezing Rain",weather_LightRain="Light Rain",weather_LightShowers="Light Showers",weather_LightSnow="Light Snow",weather_LightSnowShowers="Light Snow Showers",weather_LightThunderstormsWithHail="Light Thunderstorms With Hail",weather_MainlyClear="Mainly Clear",weather_MainlySunny="Mainly Sunny",weather_PartlyCloudy="Partly Cloudy",weather_Rain="Rain",weather_RimeFog="Rime Fog",weather_Showers="Showers",weather_Snow="Snow",weather_SnowGrains="Snow Grains",weather_SnowShowers="Snow Showers",weather_Sunny="Sunny",weather_Thunderstorm="Thunderstorm",weather_ThunderstormWithHail="Thunderstorm With Hail",WEB_text="Web App",WEB_title="Browser based application",webhook_test_disabled="Disabled: No webhook sent",webhook_test_ok="OK: POST returned a 2xx status code",website="website",Website="Website",Wed="Wed",Wednesday="Wednesday",week="week",Week="Week",week_in_plan="Week {n} of plan",Week_short="Week",Weekly="Weekly",weekly_targets_blurb="Plan your training by setting weekly targets for training load, time and/or distance. Then optionally schedule planned workouts to match the targets. Intervals.icu will track how you are doing against plan for each week.",weeks="weeks",Weeks="Weeks",Weight="Weight",weighted_avg_watts="When you ride with a power meter, you'll notice how your power jumps all over the place based on the terrain, grade, wind, and other factors. Normalized watts or weighted average power looks at all of this variation and provides an average power for your ride that is a better indicator of your effort than simply taking your average power - <a href='https://support.strava.com/hc/en-us/articles/216917147-Strava-Training-Glossary-for-Cycling' target='_blank'>strava.com</a>",Wellness="Wellness",wellness_locked_help="Prevent updates to wellness data on this day by integrations with other services and the API. This stops edits on Intervals.icu from being overwritten by incorrect data from other sources",wellness_prompt="Intervals.icu will prompt you to enter wellness information each day if you enable this setting.",WELLNESS_scope_description="Your sleep, weight, resting HR etc.",Wetsuit="Wetsuit",Wheel="Wheel",Wheelchair="Wheelchair",Wheelset="Wheelset",Width="Width",Wind="Wind",wind_arrows_windy_com="Wind arrows go to {link}",wind_deg="Wind↗",WINDOWS_text="Windows",WINDOWS_title="Microsoft Windows",Windsurf="Windsurf",WNW="WNW",work$1="The total amount of work done during the activity in kilojoules. Note that this is not the same as the amount of energy expended as cycling is only 21-23% efficient. 10 seconds riding at 300 watts results in 3000 Joules or 3 kJ of work.",Work="Work",work_above_ftp="The total amount of work done during the activity at power greater than FTP in kilojoules.",Workout="Workout",workout_conversion_settings="Files will be converted using the FTP, LTHR and pace settings for {n}",workout_hidden="1 planned workout not shown",workout_not_sent_outside_week="Only workouts scheduled for the next week can be sent",workout_not_sent_unknown="Workout was not sent for an unknown reason",workout_order="Each step in a workout can specify power, heart rate and pace targets. This setting controls which targets are used when several are available. Example: If you prefer running workouts to be based on pace instead of heart rate you should change this setting to one of the options that has pace before HR.",workout_sent_to_n="Workout sent to {n}",Workouts="Workouts",workouts_for_next_week_uploaded="Workouts for the next week are uploaded.",workouts_hidden="{n} planned workouts not shown",WORKOUTS_text="Workouts",WORKOUTS_title="Workout planners, runners and builders",would_like_to_coach_you="{name} would like to coach you. They will be able to see and edit all of your activities and settings.",would_like_to_follow_you="{name} would like to follow you. They will be able to see your activities (including private) and power and learn from your vast experience.",Wrap="Wrap",WSW="WSW",WTF="WTF?",Yaw="Yaw",year$2="year",Year="Year",Years="Years",Yes="Yes",Yesterday="Yesterday",Yoga="Yoga",You="You",you_are_already_being_coached_by="You are already being coached by {n}",you_are_following="You are following them",you_have_already_asked_to_be_coached_by="You have already asked to be coached by {n}",you_have_not_shared_fitness_charts="You have not shared any fitness charts",you_have_not_shared_input_fields="You have not shared any input fields",you_have_not_shared_plans="You have not shared any folders or plans with everyone",you_have_not_shared_trace_charts=